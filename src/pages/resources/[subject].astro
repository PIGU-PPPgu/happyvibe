---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResourceHubHeader from '../../components/ResourceHubHeader.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import { SUBJECTS, subjectBySlug, STAGES } from '../../data/subjects';
import { hubCounts } from '../../lib/hubCounts';
import { withBase } from '../../lib/urls';

export function getStaticPaths() {
  return SUBJECTS.map((s) => ({ params: { subject: s.slug } }));
}

const { subject } = Astro.params;
const meta = subjectBySlug(subject ?? '');
if (!meta) return Astro.redirect(withBase('/resources/'));

const all = (await getCollection('resources'))
  .filter((r) => r.data.subject === subject)
  .sort((a, b) => a.data.order - b.data.order);
const own = all.filter((r) => r.data.kind !== 'external');
const ext = all.filter((r) => r.data.kind === 'external');
const counts = await hubCounts();

// 按知识点分组，组内自产在前；组顺序取组内最小 order
const topics = new Map<string, typeof all>();
for (const r of all) {
  const list = topics.get(r.data.topic) ?? [];
  list.push(r);
  topics.set(r.data.topic, list);
}
const groups = [...topics.entries()]
  .map(([topic, items]) => ({
    topic,
    own: items.filter((r) => r.data.kind !== 'external'),
    ext: items.filter((r) => r.data.kind === 'external'),
    order: Math.min(...items.map((r) => r.data.order)),
  }))
  .sort((a, b) => a.order - b.order);

const stageLabel = Object.fromEntries(STAGES.map((s) => [s.key, s.label]));
const gradeSet = [...new Set(own.flatMap((r) => r.data.grades))].sort((a, b) => a - b);
const books = [...new Set(own.map((r) => r.data.book).filter(Boolean))].sort();
const units = [...new Set(own.map((r) => r.data.unit).filter(Boolean))].sort();
const SOURCE_LABEL: Record<string, string> = { smartedu: '国家智慧教育平台', phet: 'PhET', geogebra: 'GeoGebra' };
---

<BaseLayout title={`${meta.name}教学课件 · 资源中心`} description={`${meta.name}学科交互课件，按教材章节组织，单文件可投屏`}>
  <div class="container res-page">
    <ResourceHubHeader active="courseware" counts={counts} />

    <nav class="crumbs mono" aria-label="面包屑">
      <a href={withBase('/resources/')}>教学课件</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{meta.name}</span>
    </nav>

    <div class="subject-head">
      <h2 class="subject-title"><span class="mono" style={`color:${meta.accent}`}>{meta.icon}</span> {meta.name}教学课件</h2>
      <p class="text-muted">共 {own.length} 件。</p>
    </div>

    {gradeSet.length > 1 && (
      <div class="filters" role="group" aria-label="按年级筛选">
        <span class="glabel">年级</span>
        <button class="gchip on" data-g="all" type="button">全部</button>
        {gradeSet.map((g) => <button class="gchip" data-g={g} type="button">{g} 年级</button>)}
      </div>
    )}
    {books.length > 1 && (
      <div class="filters" role="group" aria-label="按教材筛选">
        <span class="glabel">教材</span>
        <button class="gchip on" data-b="all" type="button">全部</button>
        {books.map((b) => <button class="gchip" data-b={b} type="button">{b}</button>)}
      </div>
    )}
    {units.length > 1 && (
      <div class="filters" role="group" aria-label="按章节筛选">
        <span class="glabel">章节</span>
        <button class="gchip on" data-u="all" type="button">全部</button>
        {units.map((u) => <button class="gchip" data-u={u} type="button">{u}</button>)}
      </div>
    )}

    {groups.length === 0 && <p class="empty-note text-muted">该学科的课件制作中。</p>}

    {groups.map((g) => (
      <section class="topic">
        <h3 class="topic-title">{g.topic}</h3>
        <div class="cards">
          {g.own.map((r) => <ResourceCard r={r} subject={meta} showSubject={false} />)}
        </div>
        {g.ext.length > 0 && (
          <div class="elist">
            {g.ext.map((r) => (
              <a class="ecard" href={r.data.url} target="_blank" rel="noopener">
                <span class="ecard-title">{r.data.title}</span>
                <span class="ecard-meta">
                  {SOURCE_LABEL[r.data.source || ''] && <span class="esrc">{SOURCE_LABEL[r.data.source || '']}</span>}
                  <span>{stageLabel[r.data.stage]}</span>
                  <span class="earrow" aria-hidden="true">↗</span>
                </span>
              </a>
            ))}
          </div>
        )}
      </section>
    ))}
  </div>
</BaseLayout>

<script>
  const fstate = { grade: 'all', book: 'all', unit: 'all' };
  const applyF = () => {
    document.querySelectorAll<HTMLElement>('.pcard[data-grades]').forEach((card) => {
      const okG = fstate.grade === 'all' || card.dataset.grades.split(',').includes(fstate.grade);
      const okB = fstate.book === 'all' || card.dataset.book === fstate.book;
      const okU = fstate.unit === 'all' || card.dataset.unit === fstate.unit;
      card.style.display = okG && okB && okU ? '' : 'none';
    });
  };
  const bindF = (sel: string, key: 'grade' | 'book' | 'unit', attr: string) => {
    const chips = document.querySelectorAll<HTMLButtonElement>(sel);
    chips.forEach((c) =>
      c.addEventListener('click', () => {
        chips.forEach((x) => x.classList.toggle('on', x === c));
        fstate[key] = c.dataset[attr] || 'all';
        applyF();
      })
    );
  };
  bindF('.gchip[data-g]', 'grade', 'g');
  bindF('.gchip[data-b]', 'book', 'b');
  bindF('.gchip[data-u]', 'unit', 'u');
</script>

<style>
  .res-page { padding-block: 48px 40px; display: flex; flex-direction: column; gap: 20px; }
  .crumbs { font-size: 13px; display: flex; gap: 8px; color: var(--text-faint); }
  .crumbs a { color: var(--text-muted); }
  .crumbs a:hover { color: var(--gold-soft); }
  .subject-head { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .subject-title { margin: 0; font-size: 24px; }
  .subject-head p { margin: 0; font-size: 14px; }
  .empty-note { padding: 30px 0; }
  .topic { display: flex; flex-direction: column; gap: 12px; }
  .topic-title { margin: 0; font-size: 18px; color: var(--gold-soft); border-left: 3px solid var(--gold); padding-left: 10px; }
  .filters { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .glabel { font-size: 13px; color: var(--text-faint); margin-right: 4px; }
  .gchip {
    font: inherit;
    font-size: 13.5px;
    padding: 5px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: border-color .15s, color .15s, background .15s;
  }
  .gchip:hover { border-color: var(--gold); color: var(--text); }
  .gchip.on { border-color: var(--gold); color: var(--gold); background: rgba(232, 176, 75, .12); font-weight: 600; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(420px, 1fr)); gap: 20px; }
  @media (max-width: 480px) {
    .cards { grid-template-columns: 1fr; }
  }

  /* ---------- 外链资源：紧凑行 ---------- */
  .elist { display: flex; flex-direction: column; gap: 8px; }
  .ecard {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 16px;
    background: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color .2s;
  }
  .ecard:hover { border-color: var(--line-strong); }
  .ecard-title { color: var(--text); font-size: 15px; font-weight: 500; line-height: 1.5; }
  .ecard:hover .ecard-title { color: var(--gold-soft); }
  .ecard-meta { display: flex; align-items: baseline; gap: 10px; font-size: 12.5px; color: var(--text-faint); white-space: nowrap; }
  .esrc { color: var(--purple-soft); }
  .earrow { color: var(--text-faint); }
  @media (max-width: 640px) {
    .ecard { flex-direction: column; gap: 4px; }
  }
</style>
