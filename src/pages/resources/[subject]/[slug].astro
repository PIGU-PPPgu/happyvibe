---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { subjectBySlug, STAGES } from '../../../data/subjects';
import { withBase } from '../../../lib/urls';

export async function getStaticPaths() {
  const own = (await getCollection('resources')).filter((r) => r.data.kind !== 'external');
  return own.map((r) => ({ params: { subject: r.data.subject, slug: r.id.split('/').pop() }, props: { r } }));
}

const { r } = Astro.props;
const d = r.data;
const meta = subjectBySlug(d.subject);
const { Content } = await render(r);

const lessons = await getCollection('lessons');
const related = (d.relatedLessons ?? [])
  .map((id) => lessons.find((l) => `${l.data.module}/${l.id.split('/').pop()}` === id))
  .filter((l) => l !== undefined);

const stage = STAGES.find((s) => s.key === d.stage)?.label ?? '';
const live = withBase(`/interactives/${d.file}`);
const file = withBase(`/interactives/${d.file}.html`);
const lessonHref = (l: (typeof lessons)[number]) => withBase(`/modules/${l.data.module}/${l.id.split('/').pop()}/`);
const metaChips = [meta?.name, `${d.grades.join('、')} 年级 · ${stage}`, d.book, d.unit, d.pages ? `共 ${d.pages} 页` : ''].filter(Boolean);
---

<BaseLayout title={`${d.title} · 资源中心`} description={d.usage}>
  <div class="container res-detail">
    <nav class="crumbs mono" aria-label="面包屑">
      <a href={withBase('/resources/')}>教学课件</a><span aria-hidden="true">/</span>
      <a href={withBase(`/resources/${d.subject}/`)}>{meta?.name}</a><span aria-hidden="true">/</span>
      <span aria-current="page">{d.topic}</span>
    </nav>

    <header class="rd-head">
      <div class="rd-head-text">
        <h1 class="rd-title" data-pagefind-meta="title">{d.title}</h1>
        <ul class="rd-meta">
          {metaChips.map((c) => <li>{c}</li>)}
        </ul>
      </div>
      <div class="rd-actions">
        <a class="btn btn-gold" href={live} target="_blank" rel="noopener">全屏打开</a>
        <a class="btn btn-ghost" href={file} download>下载单文件</a>
      </div>
    </header>

    <div class="rd-layout">
      <div class="rd-main" data-pagefind-body>
        <section class="rd-player" aria-label="课件试玩">
          <iframe src={`${live}?embed=1`} title={`${d.title} 课件试玩`} loading="lazy" allowfullscreen></iframe>
          <p class="rd-hint text-muted">先点一下课件，键盘快捷键才会生效。</p>
        </section>

        {d.quickstart && d.quickstart.length > 0 && (
          <section class="rd-sec" aria-label="课堂使用步骤">
            <h2 class="rd-h2">课堂使用步骤</h2>
            <ol class="rd-steps">
              {d.quickstart.map((s) => <li>{s}</li>)}
            </ol>
          </section>
        )}

        <section class="rd-sec" aria-label="教学设计">
          <h2 class="rd-h2">教学设计</h2>
          <div class="prose">
            <Content />
          </div>
        </section>

        {related.length > 0 && (
          <section class="rd-sec" aria-label="相关课程">
            <h2 class="rd-h2">相关课程</h2>
            <ul class="rd-related">
              {related.map((l) => (
                <li>
                  <a href={lessonHref(l)}>{l.data.title}</a>
                  <span class="text-muted">{l.data.description}</span>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>

      {d.keys && d.keys.length > 0 && (
        <aside class="rd-aside" aria-label="上课操作">
          <div class="rd-keys">
            <h2 class="rd-h2">上课操作</h2>
            <dl>
              {d.keys.map(([k, v]) => (
                <div>
                  <dt><kbd>{k}</kbd></dt>
                  <dd>{v}</dd>
                </div>
              ))}
            </dl>
          </div>
        </aside>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .res-detail { padding-block: 28px 40px; display: flex; flex-direction: column; gap: 20px; }
  .crumbs { font-size: 13px; display: flex; flex-wrap: wrap; gap: 8px; color: var(--text-faint); }
  .crumbs a { color: var(--text-muted); }
  .crumbs a:hover { color: var(--gold-soft); }

  .rd-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; }
  .rd-title { margin: 0 0 10px; font-size: clamp(26px, 4vw, 36px); line-height: 1.3; }
  .rd-meta { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .rd-meta li {
    font-size: 13px;
    padding: 3px 11px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--text-muted);
  }
  .rd-actions { display: flex; gap: 10px; flex-wrap: wrap; padding-bottom: 4px; }

  .rd-layout { display: grid; grid-template-columns: minmax(0, 1fr) 240px; gap: 24px; align-items: start; }
  .rd-player { border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--bg-panel); }
  .rd-player iframe { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; }
  .rd-hint { margin: 0; padding: 10px 16px; font-size: 13px; border-top: 1px solid var(--line); }

  .rd-sec { margin-top: 30px; }
  .rd-h2 { font-size: 22px; margin: 0 0 14px; }
  .rd-steps { margin: 0; padding: 0; list-style: none; counter-reset: step; display: flex; flex-direction: column; gap: 12px; }
  .rd-steps li {
    counter-increment: step;
    position: relative;
    padding-left: 48px;
    font-size: 16px;
    line-height: 1.8;
  }
  .rd-steps li::before {
    content: counter(step, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 3px;
    font-family: var(--mono);
    font-size: 14px;
    color: var(--gold);
    border: 1px solid var(--line-gold);
    border-radius: var(--radius-sm);
    padding: 1px 8px;
  }

  .rd-aside { position: sticky; top: calc(var(--header-h) + 16px); }
  .rd-keys { border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-panel); padding: 16px 18px; }
  .rd-keys dl { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .rd-keys dl div { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
  kbd {
    font-family: var(--mono);
    font-size: 12.5px;
    padding: 2px 8px;
    border-radius: 5px;
    border: 1px solid var(--line-strong);
    background: var(--bg-inset);
    color: var(--gold-soft);
    white-space: nowrap;
  }
  .rd-keys dd { margin: 0; font-size: 14px; color: var(--text-muted); text-align: right; }

  .rd-related { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .rd-related a { font-weight: 600; }
  .rd-related span { display: block; font-size: 14px; margin-top: 2px; line-height: 1.7; }

  @media (max-width: 980px) {
    .rd-layout { grid-template-columns: 1fr; }
    .rd-aside { position: static; }
  }
</style>
