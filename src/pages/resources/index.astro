---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResourceHubHeader from '../../components/ResourceHubHeader.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import { SUBJECTS } from '../../data/subjects';
import { hubCounts } from '../../lib/hubCounts';
import { withBase } from '../../lib/urls';

const all = await getCollection('resources');
const own = all.filter((r) => r.data.kind !== 'external').sort((a, b) => a.data.order - b.data.order);
const counts = await hubCounts();
const subjectOf = Object.fromEntries(SUBJECTS.map((s) => [s.slug, s]));
const countOf = (slug: string) => own.filter((r) => r.data.subject === slug).length;

// 筛选器按数量出现：件数少了，筛选器比内容还多
const SHOW_FACETS = own.length >= 6;
const valuesOf = (pick: (r: (typeof own)[number]) => string[]) => [...new Set(own.flatMap(pick))].filter(Boolean);
const FACETS = [
  { key: 'grade', label: '年级', values: valuesOf((r) => r.data.grades.map(String)) },
  { key: 'book', label: '教材', values: valuesOf((r) => [r.data.book || '']) },
  { key: 'unit', label: '章节', values: valuesOf((r) => [r.data.unit || '']) },
];
---

<BaseLayout title="资源中心 · 教学课件" description="K12 学科交互课件：单文件可下载、断网可投屏，按教材章节组织，每件都带教学设计">
  <div class="container res-page">
    <ResourceHubHeader active="courseware" counts={counts}>
      <span slot="note">自产课件是单文件网页，下载后断网双击即可投屏。每件按教材章节组织，都带教学设计与课堂使用步骤。</span>
    </ResourceHubHeader>

    <section aria-label="教学课件">
      <div class="head">
        <div class="filters" role="group" aria-label="按学科筛选">
          <span class="glabel">学科</span>
          <button class="fchip on" data-f="all" type="button">全部 <b>{own.length}</b></button>
          {SUBJECTS.map((s) => {
            const n = countOf(s.slug);
            return n > 0 ? (
              <button class="fchip" data-f={s.slug} data-href={withBase(`/resources/${s.slug}/`)} type="button" style={`--accent:${s.accent}`}>
                {s.icon} {s.name} <b>{n}</b>
              </button>
            ) : (
              <span class="fchip off" aria-disabled="true">{s.icon} {s.name}</span>
            );
          })}
        </div>
        <p class="strip-note text-muted" data-sel-note>未上线的学科按教材章节逐件制作。</p>

        {SHOW_FACETS && FACETS.map((f) => (
          <div class="filters" aria-label={`按${f.label}筛选`}>
            <span class="glabel">{f.label}</span><span class="facet" id={`facet-${f.key}`}></span>
          </div>
        ))}
      </div>

      <div class="cards" id="own-cards">
        {own.map((r) => <ResourceCard r={r} subject={subjectOf[r.data.subject]} />)}
      </div>
      {own.length === 0 && <p class="empty-note text-muted">课件制作中，将按教材章节陆续上线。</p>}
    </section>
  </div>
</BaseLayout>

<script>
  // 学科 chip：有课件的学科是筛选按钮，没有的置灰不可点
  const cards = [...document.querySelectorAll<HTMLElement>('.pcard[data-subject]')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.fchip[data-f]')];
  const note = document.querySelector<HTMLElement>('[data-sel-note]');
  const baseNote = note?.textContent ?? '';
  const state: Record<string, string> = { subject: 'all', grade: 'all', book: 'all', unit: 'all' };

  // 年级 / 教材 / 章节联动（页面渲染了这些筛选排时才存在）
  const FACETS = [...document.querySelectorAll<HTMLElement>('.facet')].map((el) => ({
    key: el.id.replace('facet-', ''),
    el,
    num: el.id === 'facet-grade',
    suffix: el.id === 'facet-grade' ? ' 年级' : '',
  }));
  const valOf = (c: HTMLElement, key: string): string[] =>
    key === 'subject'
      ? [c.dataset.subject || '']
      : key === 'grade'
        ? (c.dataset.grades || '').split(',').filter(Boolean)
        : key === 'book'
          ? [c.dataset.book || '']
          : [c.dataset.unit || ''];
  const matches = (c: HTMLElement, skip?: string) => {
    for (const k of Object.keys(state)) {
      if (k === skip || state[k] === 'all') continue;
      if (!valOf(c, k).includes(state[k])) return false;
    }
    return true;
  };
  // 任一筛选变化后，其余各排的选项 = 当前结果集里实际存在的值（带计数）；失效的选择自动收回
  const renderFacets = () => {
    cards.forEach((c) => (c.style.display = matches(c) ? '' : 'none'));
    for (const f of FACETS) {
      const counts = new Map<string, number>();
      for (const c of cards) {
        if (!matches(c, f.key)) continue;
        for (const v of valOf(c, f.key)) if (v) counts.set(v, (counts.get(v) || 0) + 1);
      }
      if (state[f.key] !== 'all' && !counts.has(state[f.key])) state[f.key] = 'all';
      const opts = [...counts.keys()].sort((a, b) => (f.num ? Number(a) - Number(b) : a.localeCompare(b, 'zh')));
      f.el.innerHTML = '';
      const mk = (v: string, text: string) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'gchip' + (state[f.key] === v ? ' on' : '');
        b.textContent = text;
        b.addEventListener('click', () => {
          state[f.key] = v;
          renderFacets();
        });
        f.el.appendChild(b);
      };
      mk('all', `全部 ${cards.filter((c) => matches(c, f.key)).length}`);
      for (const v of opts) mk(v, `${v}${f.suffix} ${counts.get(v)}`);
    }
  };

  const refresh = () => {
    if (FACETS.length > 0) {
      renderFacets();
    } else {
      const key = state.subject;
      cards.forEach((c) => (c.style.display = key === 'all' || c.dataset.subject === key ? '' : 'none'));
    }
    // 选中某学科后，说明行换成该学科的件数与学科页入口
    const chip = chips.find((c) => c.dataset.f === state.subject);
    if (!note) return;
    if (state.subject === 'all' || !chip) {
      note.textContent = baseNote;
      return;
    }
    const n = cards.filter((c) => c.dataset.subject === state.subject).length;
    note.textContent = '';
    note.append(`只看该学科，共 ${n} 件 · `);
    const a = document.createElement('a');
    a.href = chip.dataset.href || '';
    a.textContent = '进入学科页 →';
    note.append(a);
  };

  chips.forEach((c) =>
    c.addEventListener('click', () => {
      chips.forEach((x) => x.classList.toggle('on', x === c));
      state.subject = c.dataset.f || 'all';
      refresh();
    })
  );
</script>

<style>
  .res-page { padding-block: 48px 40px; display: flex; flex-direction: column; gap: 22px; }
  .filters { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .facet { display: inline-flex; flex-wrap: wrap; gap: 8px; }
  .glabel { font-size: 13px; color: var(--text-faint); margin-right: 4px; }
  .gchip,
  .fchip {
    font: inherit;
    font-size: 14px;
    padding: 6px 15px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: border-color .15s, color .15s, background .15s;
  }
  .fchip b { font-weight: 600; font-family: var(--mono); font-size: 12px; margin-left: 3px; color: var(--text-faint); }
  .fchip:hover { border-color: var(--accent, var(--line-strong)); color: var(--text); }
  .fchip:hover b { color: var(--text-muted); }
  .fchip.on {
    border-color: var(--accent, var(--gold));
    color: var(--accent, var(--gold));
    background: color-mix(in srgb, var(--accent, var(--gold)) 12%, transparent);
    font-weight: 600;
  }
  .fchip.on b { color: inherit; }
  /* 没上线的学科：置灰、不可点 */
  .fchip.off { color: var(--text-faint); opacity: .6; cursor: default; border-style: dashed; }
  .gchip:hover { border-color: var(--gold); color: var(--text); }
  .gchip.on { border-color: var(--gold); color: var(--gold); background: rgba(232, 176, 75, .12); font-weight: 600; }
  .head { display: flex; flex-direction: column; gap: 10px; }
  .strip-note { margin: 0; font-size: 14px; }
  .strip-note a { color: var(--gold-soft); }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(420px, 1fr)); gap: 20px; margin-top: 14px; }
  .empty-note { padding: 30px 0; font-size: 15px; }
  @media (max-width: 480px) {
    .cards { grid-template-columns: 1fr; }
  }
</style>
