---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResourceHubHeader from '../../components/ResourceHubHeader.astro';
import SkillCard from '../../components/SkillCard.astro';
import SkillLeaderboard from '../../components/SkillLeaderboard.astro';
import report from '../../data/skill-eval-report.json';
import { CATEGORIES } from '../../data/skill-standard';
import { hubCounts } from '../../lib/hubCounts';
import { loadSkills } from '../../lib/skillEntries';
import { COMPOSITION_LABEL, PLATFORM_LABEL, REQUIRES_LABEL, categoryLabel } from '../../lib/skillLabels';
import { withBase } from '../../lib/urls';

const { tested, pending, rejected } = await loadSkills();
const counts = await hubCounts();
const hasTested = tested.length > 0;
// 已实测条目达到十个才出榜单
const showBoard = tested.length >= 10;

// 没有任何已实测条目的品类不出现在左栏
const cats = CATEGORIES.map((c) => ({ ...c, n: tested.filter((s) => s.data.category === c.key).length })).filter((c) => c.n > 0);
const mirrorCount = pending.filter((s) => s.data.distribution === 'mirror').length;
// 候选池分两类：进了这一轮实测的（在候选表里，评完出分），和人工复核时没入围的（这一轮不测，不会有分数）
const inBatch = new Set<string>(report.candidateSlugs ?? []);
const poolIn = pending.filter((s) => inBatch.has(s.slug));
const poolOut = pending.filter((s) => !inBatch.has(s.slug));
const sourceName = (kind: string) => (kind === 'skillhub' ? 'SkillHub' : kind === 'github' ? 'GitHub' : '本站');
---

<BaseLayout title="资源中心 · Skill 工坊" description="给中小学老师的 Agent 技能，用真实教师任务实测过才出分；分数、短板、实测层级和证据公开">
  <div class="container hub-page">
    <ResourceHubHeader active="skills" counts={counts}>
      <span slot="note">
        {hasTested
          ? '出了分的 Skill 都用真实教师任务实测过，分数、短板和证据都公开，并标明在哪一层、用哪个模型测的。还没出分的列在候选池里。'
          : '候选技能已完成静态审查，还没有实测。按规矩，没实测不出分。'}
        <span class="std-links">
          <a class="std-link" href={withBase('/skills/standard/')}>评价标准 →</a>
          {report.funnel.ran > 0 && <a class="std-link" href={withBase('/skills/eval-report/')}>这次怎么测的 →</a>}
        </span>
      </span>
    </ResourceHubHeader>

    {showBoard && <SkillLeaderboard skills={tested} />}

    {hasTested && (
      <div class="hub-layout">
        <aside class="hub-rail" aria-label="按品类筛选">
          <button class="cat on" data-cat="all" type="button"><span class="ci mono">≡</span>全部<span class="cn mono">{tested.length}</span></button>
          {cats.map((c) => (
            <button class="cat" data-cat={c.key} type="button"><span class="ci mono">{c.icon}</span>{c.label}<span class="cn mono">{c.n}</span></button>
          ))}
          <label class="sort-label" for="skill-sort">排序</label>
          <select id="skill-sort" class="sort">
            <option value="score">按评分</option>
            <option value="date">按最新评测</option>
          </select>
        </aside>

        <div class="hub-main">
          <div class="sk-grid" id="skill-grid">
            {tested.map((s) => <SkillCard skill={s} />)}
          </div>
          <p class="empty-note text-muted" data-cat-empty hidden>这个品类还没有已实测的技能。</p>
        </div>
      </div>
    )}

    {!hasTested && (
      <section class="status card" aria-label="当前状态">
        <h2 class="status-t">已实测的技能还在测</h2>
        <p class="status-d">
          首批候选 {pending.length} 个，来源与许可证都已核对，其中 {mirrorCount} 个明确开源、已打包可下载。
          实测按固定任务在后台开新会话跑，记录耗时和要改的地方，再按规则算分。
        </p>
        <a class="btn btn-ghost" href={withBase('/skills/standard/')}>看怎么测</a>
      </section>
    )}

    {pending.length > 0 && (
      <section class="pool" aria-label="候选池">
        <h2 class="pool-t">候选池<span class="pool-n mono">{pending.length}</span></h2>
        {poolIn.length > 0 && (
          <p class="pool-d text-muted">其中 {poolIn.length} 个进了第一轮实测。评审和抽检做完才出分，现在还没有分数，也还没有评测档案。</p>
        )}
        {poolOut.length > 0 && (
          <p class="pool-d text-muted">另外 {poolOut.length} 个在人工复核时评分不够或被淘汰，这一轮没有测，不会有分数，列在这里只作记录。</p>
        )}
        <div class="p-grid">
          {pending.map((s) => {
            const d = s.data;
            const lic = d.source.license || '未标注许可';
            return (
              <article class="p-card">
                <div class="p-head">
                  <h3 class="p-title"><a href={withBase(`/skills/${s.slug}/`)}>{d.title}</a></h3>
                  <span class="p-status">{inBatch.has(s.slug) ? '待出分' : '未入围'}</span>
                </div>
                <p class="p-does">{d.does}</p>
                <p class="p-sum">{d.summary}</p>
                <ul class="p-meta">
                  <li>{categoryLabel(d.category)}</li>
                  <li>{sourceName(d.source.kind)}</li>
                  <li>{d.distribution === 'mirror' ? lic : `${lic} · 只评不转`}</li>
                  <li>{COMPOSITION_LABEL[d.composition]}</li>
                  {d.requires.map((r) => <li class="need">{REQUIRES_LABEL[r] ?? r}</li>)}
                </ul>
                <p class="p-foot">
                  <span class="pl">{d.platforms.map((p) => PLATFORM_LABEL[p] ?? p).join('、')}</span>
                  <a class="go" href={withBase(`/skills/${s.slug}/`)}>查看详情 →</a>
                </p>
              </article>
            );
          })}
        </div>
      </section>
    )}

    {rejected.length > 0 && (
      <section class="pool" aria-label="测过不收">
        <h2 class="pool-t">测过不收<span class="pool-n mono">{rejected.length}</span></h2>
        <ul class="r-list">
          {rejected.map((s) => (
            <li>
              <a href={withBase(`/skills/${s.slug}/`)}>{s.data.title}</a>
              <span class="text-muted">{s.data.rejectReason}</span>
              <span class="r-date mono">{s.data.score?.tested.date ?? ''}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>

<script>
  // 已实测技能：左栏品类筛选 + 排序（仅在有已实测条目时这些控件才存在）
  const cards = [...document.querySelectorAll<HTMLElement>('[data-skill-card]')];
  const cats = [...document.querySelectorAll<HTMLButtonElement>('.cat[data-cat]')];
  const sort = document.getElementById('skill-sort') as HTMLSelectElement | null;
  const grid = document.getElementById('skill-grid');
  const empty = document.querySelector<HTMLElement>('[data-cat-empty]');
  let cat = 'all';

  const apply = () => {
    let shown = 0;
    cards.forEach((c) => {
      const ok = cat === 'all' || c.dataset.category === cat;
      c.style.display = ok ? '' : 'none';
      if (ok) shown++;
    });
    if (empty) empty.hidden = shown > 0;
    if (grid && sort) {
      const sorted = [...cards].sort((a, b) =>
        sort.value === 'date'
          ? (b.dataset.date ?? '').localeCompare(a.dataset.date ?? '')
          : Number(b.dataset.total ?? 0) - Number(a.dataset.total ?? 0)
      );
      sorted.forEach((c) => grid.appendChild(c));
    }
  };
  cats.forEach((c) =>
    c.addEventListener('click', () => {
      cats.forEach((x) => x.classList.toggle('on', x === c));
      cat = c.dataset.cat ?? 'all';
      apply();
    })
  );
  sort?.addEventListener('change', apply);
</script>

<style>
  .hub-page { padding-block: 48px 40px; display: flex; flex-direction: column; gap: 22px; }
  .std-link { color: var(--gold-soft); margin-left: 10px; white-space: nowrap; }
  .std-links { white-space: nowrap; }

  .hub-layout { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 24px; align-items: start; }
  .hub-rail { position: sticky; top: calc(var(--header-h) + 16px); display: flex; flex-direction: column; gap: 4px; }
  .cat {
    display: flex; align-items: center; gap: 10px;
    font: inherit; font-size: 14.5px; text-align: left;
    padding: 9px 12px; border-radius: var(--radius-sm);
    border: 1px solid transparent; background: transparent; color: var(--text-muted); cursor: pointer;
    transition: color .15s, background .15s, border-color .15s;
  }
  .cat:hover { color: var(--text); background: var(--bg-panel); }
  .cat.on { color: var(--gold-soft); background: rgba(232, 176, 75, .12); border-color: var(--line-gold); font-weight: 600; }
  .ci { width: 18px; text-align: center; color: var(--text-faint); }
  .cat.on .ci { color: var(--gold); }
  .cn { margin-left: auto; font-size: 12.5px; color: var(--text-faint); }
  .cat.on .cn { color: inherit; }
  .sort-label { margin: 16px 0 6px; font-size: 13px; color: var(--text-faint); }
  .sort {
    font: inherit; font-size: 14px; padding: 7px 10px; border-radius: var(--radius-sm);
    border: 1px solid var(--line-strong); background: var(--bg-panel); color: var(--text);
  }
  .sk-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(380px, 100%), 1fr)); gap: 16px; }
  .empty-note { padding: 30px 0; font-size: 15px; }

  .status { padding: 24px 26px; }
  .status-t { margin: 0 0 8px; font-size: 22px; }
  .status-d { margin: 0 0 16px; color: var(--text-muted); line-height: 1.85; max-width: 46em; }

  .pool { display: flex; flex-direction: column; gap: 12px; margin-top: 8px; }
  .pool-t { margin: 0; font-size: 22px; display: flex; align-items: baseline; gap: 10px; }
  .pool-n { font-size: 13px; color: var(--text-faint); font-weight: 400; }
  .pool-d { margin: 0; font-size: 14.5px; }
  .p-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(420px, 100%), 1fr)); gap: 16px; margin-top: 6px; }
  .p-card {
    display: flex; flex-direction: column; gap: 8px;
    padding: 18px 20px 14px;
    border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-panel);
    transition: border-color .2s;
  }
  .p-card:hover { border-color: var(--line-strong); }
  .p-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .p-title { margin: 0; font-size: 18px; line-height: 1.4; }
  .p-title a { color: var(--text); text-decoration: none; }
  .p-title a:hover { color: var(--gold-soft); text-decoration: none; }
  .p-status {
    flex: none; font-size: 12.5px; padding: 2px 10px; border-radius: 999px;
    border: 1px dashed var(--line-strong); color: var(--text-muted); white-space: nowrap;
  }
  .p-does { margin: 0; font-size: 15px; line-height: 1.7; }
  .p-sum { margin: 0; font-size: 14px; line-height: 1.75; color: var(--text-muted); }
  .p-meta { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .p-meta li { font-size: 12.5px; padding: 2px 10px; border-radius: 999px; border: 1px solid var(--line-strong); color: var(--text-muted); }
  .p-meta .need { color: var(--gold-soft); border-color: var(--line-gold); }
  .p-foot { margin: 4px 0 0; padding-top: 10px; border-top: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .pl { font-size: 13px; color: var(--text-faint); }
  .go { font-size: 14px; font-weight: 600; color: var(--gold-soft); text-decoration: none; white-space: nowrap; }
  .go:hover { text-decoration: none; }

  .r-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .r-list li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; padding: 12px 16px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-panel); font-size: 15px; }
  .r-list a { font-weight: 600; }
  .r-date { margin-left: auto; font-size: 12.5px; color: var(--text-faint); }

  @media (max-width: 820px) {
    .hub-layout { grid-template-columns: minmax(0, 1fr); }
    .hub-rail { position: static; flex-direction: row; flex-wrap: wrap; }
    .sort-label { width: 100%; margin-top: 8px; }
  }
</style>
