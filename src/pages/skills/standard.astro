---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  CATEGORIES,
  CHECKLISTS,
  DIMS,
  LAYERS,
  PROTOCOL,
  RED_LINES,
  RULES,
  STANDARD,
  TASKS,
  TERMS,
  TIERS,
} from '../../data/skill-standard';
import { withBase } from '../../lib/urls';

const SECTIONS = [
  { id: 'questions', title: '三个问题' },
  { id: 'dims', title: '五个维度' },
  { id: 'anchors', title: '每一档怎么判' },
  { id: 'redlines', title: '红线' },
  { id: 'tiers', title: '档位' },
  { id: 'how', title: '我们怎么测' },
  { id: 'layers', title: '实测层级' },
  { id: 'tasks', title: '固定测试任务' },
  { id: 'checklists', title: '品类检查单' },
  { id: 'evidence', title: '证据从哪来' },
  { id: 'changes', title: '变更记录' },
];
const LEVELS = ['5', '4', '3', '2', '1'] as const;
const stageLabel = (id: string) => ({ daily: '每日', weekly: '每周', monthly: '每月', termly: '每学期' })[id] ?? id;
const categoryOf = (id: string) => CATEGORIES.find((c) => c.key === id);
---

<BaseLayout title="Skill 评价标准 · 资源中心" description="HappyVibe 数智学园评价一个 Skill 好不好的标准：五个维度与权重、每一档怎么判、红线、怎么实测">
  <div class="container std-page">
    <nav class="crumbs mono" aria-label="面包屑">
      <a href={withBase('/skills/')}>Skill 工坊</a><span aria-hidden="true">/</span>
      <span aria-current="page">评价标准</span>
    </nav>

    <header class="std-head">
      <p class="kicker mono">// STANDARD · v{STANDARD.version} · {STANDARD.date}</p>
      <h1 class="std-title" data-pagefind-meta="title">Skill 评价标准</h1>
      <p class="std-sub text-muted">
        每个 Skill 的分数都从实测记录里算出来。这一页说明记什么、怎么算、什么样的不收。
      </p>
    </header>

    <nav class="secnav" aria-label="本页目录">
      {SECTIONS.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
      <a class="secnav-link" href={withBase('/skills/')}>去 Skill 工坊 →</a>
    </nav>

    <div class="std-main" data-pagefind-body>
        <section id="questions" class="std-sec" aria-label="三个问题">
          <h2 class="std-h2">三个问题</h2>
          <div class="q-grid">
            <div class="q-card">
              <p class="q">我为什么用这个 Skill？</p>
              <p>卡片上有一句话理由，还有一句短板。理由说它替你做什么、省在哪，短板说你要留意什么。</p>
            </div>
            <div class="q-card">
              <p class="q">它多少分？</p>
              <p>十分制总分加档位。总分由五个维度加权算出，每个维度的分都对应一条写在下面的规则。</p>
            </div>
            <div class="q-card">
              <p class="q">从哪些维度评？</p>
              <p>五个维度、一条红线，再加每个品类一份成品检查单。同品类比高低看检查单，跨品类比总分。</p>
            </div>
          </div>
        </section>

        <section id="dims" class="std-sec" aria-label="五个维度">
          <h2 class="std-h2">五个维度</h2>
          <p class="lead">每维 1 到 5 分。省时和出活合占一半，因为这两项就是「实用」本身；好上手决定不懂技术的老师能不能走到价值那一步；懂教育是与通用市场的差别所在；放心用是底线。</p>
          <div class="tbl-wrap">
            <table class="tbl">
              <thead><tr><th scope="col">维度</th><th scope="col">权重</th><th scope="col">老师的疑问</th></tr></thead>
              <tbody>
                {DIMS.map((d) => (
                  <tr><th scope="row">{d.label}</th><td class="mono">{d.weight}%</td><td>{d.question}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="formula mono">总分 = 各维度分 ÷ 5 × 权重，相加后折成十分制，保留一位小数。</p>
        </section>

        <section id="anchors" class="std-sec" aria-label="每一档怎么判">
          <h2 class="std-h2">每一档怎么判</h2>
          <p class="lead">评测员只记事实，分由规则算出。两个人评同一个 Skill，会得到同一组分。</p>
          <div class="anchor-list">
            {DIMS.map((d) => (
              <div class="anchor-card">
                <h3 class="anchor-title">{d.label}<span class="mono anchor-w">权重 {d.weight}%</span></h3>
                <p class="anchor-q">{d.question}</p>
                <div class="tbl-wrap">
                  <table class="tbl">
                    <thead><tr><th scope="col">分</th><th scope="col">标准</th></tr></thead>
                    <tbody>
                      {LEVELS.map((lv) => (
                        <tr class:list={[{ top: lv === '5' }]}><td class="mono lv">{lv}</td><td>{d.anchors[lv]}</td></tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ))}
          </div>
        </section>

        <section id="redlines" class="std-sec" aria-label="红线">
          <h2 class="std-h2">红线</h2>
          <p class="lead">碰任何一条都不收，不看总分。</p>
          <ol class="redlines">
            {RED_LINES.map((r) => <li>{r}</li>)}
          </ol>
        </section>

        <section id="tiers" class="std-sec" aria-label="档位">
          <h2 class="std-h2">档位</h2>
          <div class="tbl-wrap">
            <table class="tbl">
              <thead><tr><th scope="col">总分</th><th scope="col">档位</th><th scope="col">含义</th></tr></thead>
              <tbody>
                {TIERS.map((t, i) => {
                  const upper = TIERS[i - 1];
                  const range = !upper ? `${t.min.toFixed(1)} 起` : t.min === 0 ? `${upper.min.toFixed(1)} 以下` : `${t.min.toFixed(1)} 到 ${(upper.min - 0.1).toFixed(1)}`;
                  return <tr><td class="mono">{range}</td><th scope="row">{t.label}</th><td>{t.meaning}</td></tr>;
                })}
              </tbody>
            </table>
          </div>
        </section>

        <section id="how" class="std-sec" aria-label="我们怎么测">
          <h2 class="std-h2">我们怎么测</h2>
          <div class="flow">
            <iframe data-flow data-base={withBase('/interactives/skill-eval-flow')} title="Skill 评测流程图" allowfullscreen></iframe>
            <p class="flow-foot text-muted">
              <span class="flow-tip">图可以拖动、缩放，点节点看说明。</span>
              <a class="btn btn-ghost flow-open" href={withBase('/interactives/skill-eval-flow')} target="_blank" rel="noopener">全屏打开流程图 →</a>
            </p>
          </div>
          <ol class="steps">
            {PROTOCOL.map((p) => (
              <li><strong>{p.title}</strong><span>{p.detail}</span></li>
            ))}
          </ol>
          <h3 class="std-h3">五条规矩</h3>
          <ol class="redlines">
            {RULES.map((r) => <li>{r}</li>)}
          </ol>
          <h3 class="std-h3">名词口径</h3>
          <dl class="terms">
            {TERMS.map((t) => (
              <div><dt>{t.term}</dt><dd>{t.meaning}</dd></div>
            ))}
          </dl>
        </section>

        <section id="layers" class="std-sec" aria-label="实测层级">
          <h2 class="std-h2">实测层级</h2>
          <p class="lead">分数在哪一层测出来的，卡片上就标哪一层。层级只决定用哪份证据当主分，不参与算分。</p>
          <dl class="terms">
            {LAYERS.map((l) => (
              <div><dt>{l.label}</dt><dd>{l.meaning}</dd></div>
            ))}
          </dl>
          <p class="lead">后台两层都测过的技能，主分用同款复核的结果，海选的分数并列显示。</p>
        </section>

        <section id="tasks" class="std-sec" aria-label="固定测试任务">
          <h2 class="std-h2">固定测试任务</h2>
          <p class="lead">同品类的 Skill 用同一道任务，分数才可比。任务用统一的脱敏输入。</p>
          <div class="tasks">
            {TASKS.map((t) => (
              <div class="task">
                <p class="task-head mono">{t.id}{t.note ? ` · ${t.note}` : ''}<span class="task-meta">{categoryOf(t.category)?.label} · {t.role === 'main' ? '主任务' : '副任务'} · {stageLabel(t.frequency)}</span></p>
                <p class="task-prompt">{t.prompt}</p>
                {t.attach && <a class="task-attach" href={withBase(t.attach)} download>下载测试用的成绩表</a>}
              </div>
            ))}
          </div>
        </section>

        <section id="checklists" class="std-sec" aria-label="品类检查单">
          <h2 class="std-h2">品类检查单</h2>
          <p class="lead">五维用来跨品类比总分，检查单用来同品类分高下。「出活」和「懂教育」两维的分直接从检查单的通过情况来。</p>
          <div class="cl-list">
            {CATEGORIES.map((c) => {
              const list = CHECKLISTS[c.key];
              return (
                <details class="cl">
                  <summary>
                    <span class="cl-name">{c.label}</span>
                    <span class="mono cl-n">{list ? `${list.length} 条` : '待制定'}</span>
                  </summary>
                  {list ? (
                    <div class="tbl-wrap">
                      <table class="tbl">
                        <thead><tr><th scope="col">编号</th><th scope="col">计入</th><th scope="col">条目</th></tr></thead>
                        <tbody>
                          {list.map((it) => (
                            <tr><td class="mono now">{it.id}</td><td class="now">{it.kind === 'Q' ? '出活' : it.rule ? '懂教育 · 规矩' : '懂教育'}</td><td>{it.text}<span class="cl-how">判法：{it.how}</span></td></tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  ) : (
                    <p class="cl-pending text-muted">在第一个该品类的 Skill 入库前制定，并经教研终审。</p>
                  )}
                </details>
              );
            })}
          </div>
        </section>

        <section id="evidence" class="std-sec" aria-label="证据从哪来">
          <h2 class="std-h2">证据从哪来</h2>
          <dl class="terms">
            <div>
              <dt>AI 代测</dt>
              <dd>由 AI 按固定任务实测并记录，可以在 WorkBuddy 桌面版，也可以在后台会话。评测档案写明实测层级、Agent 与模型。</dd>
            </div>
            <div>
              <dt>教师试用</dt>
              <dd>由老师亲手试用后给出的确认。它和 AI 代测是两种证据，各自有各自的标记，不互相替代。</dd>
            </div>
            <div>
              <dt>平台 AI 评分</dt>
              <dd>SkillHub 的 TRACE 评分，评的是技能写得规不规范。作为参照并列显示，不计入这里的总分。</dd>
            </div>
          </dl>
        </section>

        <section id="changes" class="std-sec" aria-label="变更记录">
          <h2 class="std-h2">变更记录</h2>
          <ul class="changes">
            {STANDARD.changes.map((c) => <li>{c}</li>)}
          </ul>
        </section>
    </div>
  </div>
</BaseLayout>

<style>
  .std-page { padding-block: 28px 40px; display: flex; flex-direction: column; gap: 18px; }
  .crumbs { font-size: 13px; display: flex; flex-wrap: wrap; gap: 8px; color: var(--text-faint); }
  .crumbs a { color: var(--text-muted); }
  .crumbs a:hover { color: var(--gold-soft); }
  .kicker { font-size: 13px; color: var(--gold); margin: 0 0 10px; }
  .std-title { margin: 0 0 8px; font-size: clamp(28px, 4vw, 38px); line-height: 1.3; }
  .std-sub { margin: 0; max-width: 720px; font-size: 16px; line-height: 1.8; }

  .std-sec { padding-top: 8px; margin-bottom: 44px; scroll-margin-top: calc(var(--header-h) + 76px); }
  .std-h2 { font-size: 26px; margin: 0 0 12px; line-height: 1.4; }
  .std-h3 { font-size: 18px; margin: 28px 0 10px; }
  .lead { margin: 0 0 16px; color: var(--text-muted); line-height: 1.85; max-width: 46em; }
  .secnav {
    position: sticky; top: var(--header-h); z-index: 10;
    display: flex; gap: 6px; overflow-x: auto;
    padding: 8px 4px; background: var(--bg); border-bottom: 1px solid var(--line);
    scrollbar-width: none;
  }
  .secnav::-webkit-scrollbar { display: none; }
  .secnav a { flex: none; padding: 5px 12px; border-radius: 999px; font-size: 14px; color: var(--text-muted); white-space: nowrap; }
  .secnav a:hover { color: var(--gold-soft); background: var(--bg-panel); }
  .secnav .secnav-link { color: var(--gold-soft); }

  .q-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; }
  .q-card { border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-panel); padding: 18px 20px; }
  .q-card p { margin: 0; font-size: 15px; line-height: 1.8; color: var(--text-muted); }
  .q-card .q { color: var(--text); font-weight: 700; font-size: 17px; margin-bottom: 6px; }

  .tbl-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-panel); }
  .tbl { width: 100%; border-collapse: collapse; font-size: 15px; }
  .tbl th, .tbl td { padding: 11px 14px; text-align: left; border-bottom: 1px solid var(--line); vertical-align: top; line-height: 1.7; }
  .tbl thead th { color: var(--text-muted); font-weight: 500; font-size: 13px; white-space: nowrap; }
  .tbl tbody th { font-weight: 600; color: var(--text); white-space: nowrap; }
  .tbl tbody tr:last-child th, .tbl tbody tr:last-child td { border-bottom: none; }
  .formula { margin: 12px 0 0; font-size: 13.5px; color: var(--gold-soft); }

  .anchor-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr)); gap: 16px; align-items: start; }
  .anchor-card { border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-panel); padding: 18px 20px 8px; }
  .anchor-card .tbl-wrap { border: 0; border-radius: 0; background: transparent; }
  .anchor-title { margin: 0 0 4px; font-size: 19px; display: flex; align-items: baseline; gap: 12px; }
  .anchor-w { font-size: 12.5px; color: var(--text-faint); font-weight: 400; }
  .anchor-q { margin: 0 0 12px; color: var(--gold-soft); font-size: 14.5px; }
  .lv { width: 34px; color: var(--text-faint); }
  tr.top .lv { color: var(--gold); font-weight: 700; }

  .redlines, .steps, .changes { margin: 0; padding-left: 0; list-style: none; counter-reset: n; display: flex; flex-direction: column; gap: 10px; }
  .redlines li, .steps li { counter-increment: n; position: relative; padding-left: 40px; font-size: 15.5px; line-height: 1.8; }
  .redlines li::before, .steps li::before {
    content: counter(n, decimal-leading-zero);
    position: absolute; left: 0; top: 3px;
    font-family: var(--mono); font-size: 13px; color: var(--gold);
    border: 1px solid var(--line-gold); border-radius: var(--radius-sm); padding: 1px 7px;
  }
  .steps li { display: flex; flex-direction: column; }
  .steps li strong { color: var(--text); }
  .steps li span { color: var(--text-muted); font-size: 14.5px; }

  .flow { border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--bg-panel); margin-bottom: 24px; }
  /* 图按宽度等比缩放；高度卡在内容处，不留空白 */
  .flow iframe { display: block; width: 100%; height: 530px; border: 0; }
  .flow-foot { margin: 0; padding: 10px 16px; font-size: 13px; border-top: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .flow-open { padding: 7px 16px; font-size: 13px; }

  .terms { margin: 0; display: flex; flex-direction: column; gap: 12px; }
  .terms div { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 14px; }
  .terms dt { color: var(--text); font-weight: 600; font-size: 15px; }
  .terms dd { margin: 0; color: var(--text-muted); font-size: 15px; line-height: 1.8; }

  .tasks { display: flex; flex-direction: column; gap: 12px; }
  .task { border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-panel); padding: 14px 18px; }
  .task-head { margin: 0 0 6px; font-size: 13px; color: var(--gold-soft); display: flex; flex-wrap: wrap; gap: 12px; }
  .task-meta { color: var(--text-faint); font-family: var(--sans); }
  .task-prompt { margin: 0; font-size: 15px; line-height: 1.8; }
  .task-attach { display: inline-block; margin-top: 8px; font-size: 14px; color: var(--gold-soft); }

  .cl-list { display: flex; flex-direction: column; gap: 10px; }
  .cl { border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-panel); }
  .cl summary { cursor: pointer; display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding: 13px 18px; list-style: none; font-size: 16px; font-weight: 600; }
  .cl summary::-webkit-details-marker { display: none; }
  .cl summary::before { content: '▸'; color: var(--gold); font-size: 12px; margin-right: 10px; transition: transform .15s; }
  .cl[open] > summary::before { transform: rotate(90deg); }
  .cl summary:hover { color: var(--gold-soft); }
  .cl-n { font-size: 12.5px; color: var(--text-faint); font-weight: 400; margin-left: auto; }
  .cl .tbl-wrap { border: 0; border-top: 1px solid var(--line); border-radius: 0; }
  /* 检查单条目下面的判法：比条目小一号，颜色淡一档 */
  .cl-how { display: block; margin-top: 4px; font-size: 13.5px; line-height: 1.75; color: var(--text-muted); }
  .cl .tbl .now { white-space: nowrap; }
  .cl-pending { margin: 0; padding: 0 18px 14px 40px; font-size: 14.5px; }
  .changes { padding-left: 20px; list-style: disc; color: var(--text-muted); font-size: 15px; line-height: 1.8; }

  @media (max-width: 980px) {
    .terms div { grid-template-columns: 1fr; gap: 2px; }
    .anchor-card { padding: 14px 16px 4px; }
    .secnav { margin-inline: -20px; padding-inline: 20px; }
    .std-sec { scroll-margin-top: calc(var(--header-h) + 96px); }
  }
  /* 窄屏放不下这张图：只留全屏入口，读者看下面的分步清单 */
  @media (max-width: 800px) {
    .flow iframe, .flow-tip { display: none; }
    .flow-foot { border-top: 0; justify-content: flex-start; padding: 14px 16px; }
  }
</style>

<script>
  // 流程图查看器有自己的主题开关。让它跟随站点：首次加载带上当前主题，站点切换主题时重载。
  const flow = document.querySelector<HTMLIFrameElement>('[data-flow]');
  if (flow) {
    const base = flow.dataset.base;
    const theme = () => (document.documentElement.dataset.theme === 'light' ? 'light' : 'dark');
    const load = () => {
      flow.src = `${base}?embed=1&theme=${theme()}`;
    };
    load();
    document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => setTimeout(load, 0));
  }
</script>
