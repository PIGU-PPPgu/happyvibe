---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScoreCard from '../../components/ScoreCard.astro';
import { CHECKLISTS, TASKS } from '../../data/skill-standard';
import type { ScoreFrontmatter } from '../../data/skill-schema';
import { isScored, summaryOf } from '../../lib/skillEntryCore';
import { COMPOSITION_LABEL, EVIDENCE_LABEL, LAYER_LABEL, PLATFORM_LABEL, REQUIRES_LABEL, categoryLabel, formatSeconds } from '../../lib/skillLabels';
import { withBase } from '../../lib/urls';
import report from '../../data/skill-eval-report.json';
import '../../styles/table.css';

export async function getStaticPaths() {
  const skills = await getCollection('skills');
  return skills.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const scored = isScored(d);
const summary = scored ? summaryOf(d) : null;
const s: ScoreFrontmatter | undefined = scored ? d.score : undefined;

const lessons = await getCollection('lessons');
const related = (d.relatedLessons ?? [])
  .map((id) => lessons.find((l) => `${l.data.module}/${l.id.split('/').pop()}` === id))
  .filter((l) => l !== undefined);
const lessonHref = (l: (typeof lessons)[number]) => withBase(`/modules/${l.data.module}/${l.id.split('/').pop()}/`);

const live = withBase(`/skills/${d.name}.zip`);
const upstream = d.source.url ?? (d.source.repo ? `https://github.com/${d.source.repo}` : '');
const installPrompt =
  d.distribution === 'mirror' ? `请从这个地址下载并安装技能：${live}` : `请安装技能 ${d.name}：${upstream}`;

const taskText = (id: string) => TASKS.find((t) => t.id === id)?.prompt ?? id;
const mainRuns = s ? s.runs.filter((r) => r.task === s.task) : [];
const otherRuns = s ? s.runs.filter((r) => r.task !== s.task) : [];
const allRuns = s ? [...mainRuns, ...otherRuns] : [];
const checklist = s ? (CHECKLISTS[d.category] ?? []) : [];
const checkOf = (id: string) => s?.checklist.find((c) => c.id === id);
const shots = allRuns.filter((r) => r.shot).slice(0, 3);
// 后台点名加载：技能一定被用到，「会不会自动触发」没有测
const named = s?.tested.loadedBy === 'named';

const AUDIT_LABEL = {
  network: { none: '不联网', declared: '有外联，说明书里写明了', undeclared: '有外联，说明书没写' },
  credentials: { yes: '需要密钥或登录授权', no: '不需要密钥' },
  studentData: { none: '不存学生信息', local: '把学生信息存在本机文件里' },
  overRead: { yes: '读取范围超过用途所需', no: '读取范围与用途相符' },
};
const auditFacts = s
  ? [
      AUDIT_LABEL.network[s.audit.network],
      s.audit.credentials ? AUDIT_LABEL.credentials.yes : AUDIT_LABEL.credentials.no,
      AUDIT_LABEL.studentData[s.audit.studentData],
      s.audit.overRead ? AUDIT_LABEL.overRead.yes : AUDIT_LABEL.overRead.no,
    ]
  : [];

const badge = (d: typeof entry.data) => [
  categoryLabel(d.category),
  d.platforms.map((p) => PLATFORM_LABEL[p] ?? p).join('、'),
  COMPOSITION_LABEL[d.composition],
  d.source.license || '未标注许可',
  d.distribution === 'mirror' ? '开源镜像' : '只评不转',
  ...d.requires.map((r) => `需要${REQUIRES_LABEL[r] ?? r}`),
];
// pending 条目分两种：进了这一轮实测的（在候选表里，评完出分），和人工复核时没入围的
const inBatch = (report.candidateSlugs ?? []).includes(entry.id);
const statusLine = d.status === 'tested' ? `${LAYER_LABEL[s!.tested.layer]} · ${EVIDENCE_LABEL[s!.tested.by]} · ${s!.tested.date}` : d.status === 'pending' ? (inBatch ? '待出分' : '未入围') : '不收录';
---

<BaseLayout title={`${d.title} · Skill 工坊`} description={d.does}>
  <div class="container sk-page">
    <nav class="crumbs mono" aria-label="面包屑">
      <a href={withBase('/skills/')}>Skill 工坊</a><span aria-hidden="true">/</span>
      <a href={withBase(`/skills/#${d.category}`)}>{categoryLabel(d.category)}</a><span aria-hidden="true">/</span>
      <span aria-current="page">{d.title}</span>
    </nav>

    <header class="sk-head">
      <div class="sk-head-text">
        <h1 class="sk-title" data-pagefind-meta="title">{d.title}</h1>
        <ul class="sk-meta">
          {badge(d).map((b) => <li>{b}</li>)}
          <li class:list={[{ st: true }, `st-${d.status}`]}>{statusLine}</li>
        </ul>
      </div>
      <div class="sk-actions">
        {d.distribution === 'mirror' && <a class:list={["btn", d.status === 'tested' ? "btn-gold" : "btn-ghost"]} href={live} download>下载技能包</a>}
        {d.distribution === 'link' && upstream && <a class:list={["btn", d.status === 'tested' ? "btn-gold" : "btn-ghost"]} href={upstream} target="_blank" rel="noopener">去来源页安装</a>}
        {scored && <button class="btn btn-ghost" type="button" data-copy={installPrompt}>复制安装话术</button>}
      </div>
    </header>

    {d.status === 'pending' && inBatch && (
      <p class="notice text-muted">这个技能进了第一轮实测，评审和抽检还没有做完，所以还没有分数，也没有评测档案。出分后这一页会补上评分卡。</p>
    )}
    {d.status === 'pending' && !inBatch && (
      <p class="notice text-muted">这个技能在人工复核时评分不够或被淘汰，没有进这一轮实测，所以没有分数，也没有评测档案。</p>
    )}
    {d.status === 'rejected' && (
      <p class="notice reject">不收录：{d.rejectReason}</p>
    )}

    <div class="sk-layout">
      <div class="sk-main" data-pagefind-body>
        <section class="sk-sec" aria-label="它替你做什么">
          <h2 class="sk-h2">它替你做什么</h2>
          <p class="does">{d.does}</p>
          <p class="summary">{d.summary}</p>
          {shots.length > 0 && (
            <div class="shots">
              {shots.map((r) => (
                <a href={withBase(r.shot!)} target="_blank" rel="noopener">
                  <img loading="lazy" src={withBase(r.shot!)} alt={`${d.title} 第 ${mainRuns.indexOf(r) + 1} 轮实测的输出`} />
                </a>
              ))}
            </div>
          )}
        </section>

        {scored && d.install && (
          <section class="sk-sec" aria-label="怎么装">
            <h2 class="sk-h2">怎么装</h2>
            <ol class="steps">
              {d.install.workbuddy.map((t) => <li>{t}</li>)}
            </ol>
            {d.install.generic && d.install.generic.length > 0 && (
              <>
                <h3 class="sk-h3">其它 Agent</h3>
                <ol class="steps">
                  {d.install.generic.map((t) => <li>{t}</li>)}
                </ol>
              </>
            )}
            <p class="hint text-muted">把安装话术复制下来，发给你的 Agent，它自己会装。</p>
          </section>
        )}

        {scored && (
          <section class="sk-sec" aria-label="怎么用">
            <h2 class="sk-h2">怎么用</h2>
            <p class="lead">装好后，照这样的话说：</p>
            <blockquote class="trigger">{d.trigger}</blockquote>
            {d.examples && d.examples.length > 0 && (
              <ul class="examples">
                {d.examples.map((e) => <li>{e}</li>)}
              </ul>
            )}
          </section>
        )}

        {scored && (
          <section class="sk-sec" aria-label="要注意">
            <h2 class="sk-h2">要注意</h2>
            <p class="weakness">{s!.weakness}</p>
            {d.cautions.length > 0 && (
              <ul class="cautions">
                {d.cautions.map((c) => <li>{c}</li>)}
              </ul>
            )}
          </section>
        )}

        {scored && (
          <section class="sk-sec" aria-label="评测档案" id="report">
            <h2 class="sk-h2">评测档案</h2>

            <h3 class="sk-h3">固定任务</h3>
            <p class="task"><span class="mono tid">{s!.task}</span>{taskText(s!.task)}</p>
            {[...new Set(otherRuns.map((r) => r.task))].map((id) => (
              <p class="task"><span class="mono tid">{id}</span>{taskText(id)}</p>
            ))}

            <h3 class="sk-h3">实测记录</h3>
            <div class="tbl-wrap">
              <table class="tbl">
                <thead><tr><th scope="col">轮次</th><th scope="col">任务</th><th scope="col">技能触发</th><th scope="col">耗时</th><th scope="col">修改处数</th><th scope="col">严重错误</th><th scope="col">产出</th></tr></thead>
                <tbody>
                  {allRuns.map((r, i) => (
                    <tr>
                      <td class="mono">{i + 1}</td>
                      <td class="mono">{r.task}</td>
                      <td class:list={[{ ok: r.triggered }, { bad: !r.triggered }]}>{named ? '点名加载' : r.triggered ? '是' : '否'}</td>
                      <td>{formatSeconds(r.seconds)}</td>
                      <td>{r.edits}</td>
                      <td class:list={[{ bad: r.severe > 0 }]}>{r.severe}</td>
                      <td>{r.output ? <a href={withBase(r.output)} target="_blank" rel="noopener">原文</a> : '—'}</td>
                    </tr>
                  ))}
                  <tr class="base">
                    <td class="mono">对照</td>
                    <td class="mono">{s!.task}</td>
                    <td>不装技能</td>
                    <td>{formatSeconds(s!.baseline.seconds)}</td>
                    <td>{s!.baseline.edits}</td>
                    <td class:list={[{ bad: s!.baseline.severe > 0 }]}>{s!.baseline.severe}</td>
                    <td>—</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p class="hint text-muted">修改处：老师必须改动才能用的一处。严重错误：老师没发现就会交上去的错误。</p>

            <h3 class="sk-h3">{categoryLabel(d.category)}检查单</h3>
            <div class="tbl-wrap">
              <table class="tbl">
                <thead><tr><th scope="col">编号</th><th scope="col">计入</th><th scope="col">条目</th><th scope="col">结果</th></tr></thead>
                <tbody>
                  {checklist.map((it) => {
                    const r = checkOf(it.id);
                    return (
                      <tr>
                        <td class="mono now">{it.id}</td>
                        <td class="now">{it.kind === 'Q' ? '出活' : it.rule ? '懂教育 · 规矩' : '懂教育'}</td>
                        <td>{it.text}{r?.note && <span class="cnote">{r.note}</span>}</td>
                        <td class:list={[{ now: true, ok: r?.pass === true }, { bad: r?.pass !== true }]}>{r?.pass === true ? '通过' : '不过'}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>

            {s!.textbookCheck && (
              <p class="fact">{s!.tested.layer === 'workbuddy' ? `教材抽检：抽 ${s!.textbookCheck.total} 个章节核对教材版本与章节，通过 ${s!.textbookCheck.passed} 个。` : `教材标识核对：${s!.textbookCheck.total} 轮里有 ${s!.textbookCheck.passed} 轮把任务指定的教材版本、年级、章节写全。`}</p>
            )}

            <h3 class="sk-h3">静态审查</h3>
            <ul class="facts">
              {auditFacts.map((f) => <li>{f}</li>)}
              <li>{s!.platformComplete ? '在 WorkBuddy 上功能完整' : s!.tested.layer === 'workbuddy' ? '在 WorkBuddy 上功能不完整' : '没有在 WorkBuddy 上核对功能与安装步骤'}</li>
            </ul>

            {(entry.body ?? '').trim() && (
              <>
                <h3 class="sk-h3">输出样例、修改处与评注</h3>
                <div class="prose"><Content /></div>
              </>
            )}
          </section>
        )}

        {scored && d.customize && d.customize.length > 0 && (
          <section class="sk-sec" aria-label="改成你自己学校的版本">
            <h2 class="sk-h2">改成你自己学校的版本</h2>
            <ol class="steps">
              {d.customize.map((t) => <li>{t}</li>)}
            </ol>
          </section>
        )}

        {!scored && (entry.body ?? '').trim() && (
          <section class="sk-sec" aria-label="说明">
            <div class="prose"><Content /></div>
          </section>
        )}

        {related.length > 0 && (
          <section class="sk-sec" aria-label="相关课程">
            <h2 class="sk-h2">相关课程</h2>
            <ul class="related">
              {related.map((l) => (
                <li><a href={lessonHref(l)}>{l.data.title}</a><span class="text-muted">{l.data.description}</span></li>
              ))}
            </ul>
          </section>
        )}
      </div>

      <aside class="sk-aside">
        {scored && summary && s && (
          <ScoreCard total={summary.total} tier={summary.tier} dims={summary.dims} notes={s.notes} tested={s.tested} platformScore={d.source.platformScore} overrides={s.overrides} prior={s.prior} />
        )}
        <div class="src">
          <h2 class="src-h">来源</h2>
          <dl>
            <div><dt>作者</dt><dd>{d.source.author}</dd></div>
            {upstream && <div><dt>上游</dt><dd><a href={upstream} target="_blank" rel="noopener">{d.source.kind === 'skillhub' ? 'SkillHub' : 'GitHub 仓库'} →</a></dd></div>}
            {d.source.commit && <div><dt>评测时的提交</dt><dd class="mono">{d.source.commit}</dd></div>}
            <div><dt>许可证</dt><dd>{d.source.license || '未标注'}</dd></div>
            {d.source.version && <div><dt>版本</dt><dd>{d.source.version}</dd></div>}
            <div><dt>构成</dt><dd>{COMPOSITION_LABEL[d.composition]}</dd></div>
            {d.distribution === 'mirror' && <div><dt>技能包</dt><dd>与上游文件逐字节一致，随包附许可证与来源说明</dd></div>}
            {d.requires.length > 0 && <div><dt>额外需要</dt><dd>{d.requires.map((r) => REQUIRES_LABEL[r] ?? r).join('、')}</dd></div>}
          </dl>
          <p class="src-note text-muted">评测标准见 <a href={withBase('/skills/standard/')}>Skill 评价标准</a>。</p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  btn?.addEventListener('click', async () => {
    const text = btn.dataset.copy ?? '';
    try {
      await navigator.clipboard.writeText(text);
      const old = btn.textContent;
      btn.textContent = '已复制';
      setTimeout(() => { btn.textContent = old; }, 1600);
    } catch {
      btn.textContent = '复制失败，请手动选择文字';
    }
  });
</script>

<style>
  .sk-page { padding-block: 28px 40px; display: flex; flex-direction: column; gap: 18px; }
  .crumbs { font-size: 13px; display: flex; flex-wrap: wrap; gap: 8px; color: var(--text-faint); }
  .crumbs a { color: var(--text-muted); }
  .crumbs a:hover { color: var(--gold-soft); }

  .sk-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; }
  .sk-title { margin: 0 0 10px; font-size: clamp(28px, 4vw, 38px); line-height: 1.3; }
  .sk-meta { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; max-width: 720px; }
  .sk-meta li { font-size: 13px; padding: 3px 11px; border-radius: 999px; border: 1px solid var(--line-strong); color: var(--text-muted); }
  .sk-meta .st { border-style: dashed; }
  .sk-meta .st-tested { color: var(--gold-soft); border-color: var(--line-gold); }
  .sk-meta .st-rejected { color: var(--text); border-color: var(--line-strong); }
  .sk-actions { display: flex; gap: 10px; flex-wrap: wrap; padding-bottom: 4px; }

  .notice { margin: 0; padding: 14px 18px; border: 1px dashed var(--line-strong); border-radius: var(--radius); font-size: 15px; line-height: 1.75; }
  .notice.reject { border-style: solid; border-color: var(--line-strong); color: var(--text); }

  .sk-layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 28px; align-items: start; }
  .sk-sec { margin-bottom: 40px; }
  .sk-h2 { font-size: 24px; margin: 0 0 12px; line-height: 1.4; }
  .sk-h3 { font-size: 17px; margin: 26px 0 10px; }
  .does { margin: 0 0 8px; font-size: 19px; font-weight: 600; line-height: 1.7; }
  .summary { margin: 0; font-size: 16px; line-height: 1.85; color: var(--text-muted); max-width: 46em; }
  .lead { margin: 0 0 10px; color: var(--text-muted); }
  .hint { margin: 10px 0 0; font-size: 13.5px; line-height: 1.7; }

  .shots { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; margin-top: 18px; }
  .shots a { display: block; border: 1px solid var(--line); border-radius: var(--radius-sm); overflow: hidden; background: var(--bg-inset); }
  .shots img { width: 100%; height: 150px; object-fit: top; object-fit: cover; display: block; }
  .shots a:hover { border-color: var(--line-strong); }

  .steps { margin: 0; padding: 0; list-style: none; counter-reset: n; display: flex; flex-direction: column; gap: 10px; }
  .steps li { counter-increment: n; position: relative; padding-left: 46px; font-size: 16px; line-height: 1.8; }
  .steps li::before {
    content: counter(n, decimal-leading-zero); position: absolute; left: 0; top: 3px;
    font-family: var(--mono); font-size: 14px; color: var(--gold);
    border: 1px solid var(--line-gold); border-radius: var(--radius-sm); padding: 1px 8px;
  }

  .trigger { margin: 0; padding: 14px 18px; border-left: 4px solid var(--gold); background: var(--bg-panel); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; font-size: 17px; line-height: 1.75; }
  .examples { margin: 12px 0 0; padding-left: 22px; font-size: 15px; line-height: 1.9; color: var(--text-muted); }

  .weakness { margin: 0 0 8px; font-size: 17px; font-weight: 600; line-height: 1.75; }
  .cautions { margin: 0; padding-left: 22px; font-size: 15.5px; line-height: 1.85; color: var(--text-muted); }

  .task { margin: 0 0 8px; font-size: 15px; line-height: 1.8; }
  .tid { display: inline-block; min-width: 58px; color: var(--gold-soft); margin-right: 10px; }
  .tbl .base td { color: var(--text-muted); }
  .ok { color: var(--text); }
  .bad { color: var(--gold-soft); font-weight: 600; }
  .cnote { display: block; font-size: 13.5px; color: var(--text-muted); }
  .fact { margin: 12px 0 0; font-size: 15px; }
  .facts { margin: 0; padding-left: 22px; font-size: 15px; line-height: 1.85; color: var(--text-muted); }

  .related { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .related a { font-weight: 600; }
  .related span { display: block; font-size: 14px; margin-top: 2px; line-height: 1.7; }

  .sk-aside { position: sticky; top: calc(var(--header-h) + 16px); display: flex; flex-direction: column; gap: 14px; }
  .src { border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-panel); padding: 16px 20px; }
  .src-h { font-size: 17px; margin: 0 0 10px; }
  .src dl { margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .src dl div { display: grid; grid-template-columns: 84px minmax(0, 1fr); gap: 10px; font-size: 14px; line-height: 1.6; }
  .src dt { color: var(--text-faint); }
  .src dd { margin: 0; color: var(--text); overflow-wrap: anywhere; }
  .src dd a { color: var(--gold-soft); }
  .src-note { margin: 14px 0 0; padding-top: 12px; border-top: 1px solid var(--line); font-size: 13.5px; }

  @media (max-width: 980px) {
    .sk-layout { grid-template-columns: minmax(0, 1fr); }
    .sk-aside { position: static; }
  }
</style>
