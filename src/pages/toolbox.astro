---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminalWindow from '../components/TerminalWindow.astro';
import { withBase } from '../lib/urls';

const tools = (await getCollection('tools')).sort((a, b) => a.data.order - b.data.order);

const CATS = [
  { key: 'class', label: '班级管理', icon: '▦', desc: '班主任工具 + 留痕 + 排座' },
  { key: 'teaching', label: '教学', icon: '▶', desc: '课件 + 中考题 + 上课提醒' },
  { key: 'agent', label: 'Agent / 知识库', icon: '◇', desc: 'Obsidian + WorkBuddy' },
  { key: 'skill', label: 'Skill / 脚本', icon: '◈', desc: '画图 + 飞象 + Mermaid' },
  { key: 'creation', label: '创作辅助', icon: '</>', desc: '配色 + 图标 + 组件 + 灵感' },
  { key: 'design', label: '设计美学', icon: '✦', desc: '配色 + 图标 + 站酷 + shadcn' },
  { key: 'learn', label: '进阶学习', icon: '»', desc: 'easy-vibe + MDN + Dify' },
] as const;

const cat = Astro.url.searchParams.get('cat');
const activeCat = CATS.find((c) => c.key === cat) ?? null;
const items = activeCat ? tools.filter((t) => t.data.category === activeCat.key) : [];
---
<BaseLayout title={activeCat ? `工具箱 · ${activeCat.label}` : '工具箱'} description="班主任工具、教学工具、Skill 脚本、设计资源——按分类浏览">
  <div class="container toolbox-page">
    <TerminalWindow title="happyvibe toolbox">
      <p class="kicker mono">// TOOLBOX · {tools.length} 个工具</p>
      <h1 class="tb-title">工具箱</h1>
      <p class="tb-sub text-muted">
        原则不变：<strong>大量重复、有固定流程的活才交给工具</strong>；涉及学生信息的界面分享前请脱敏。
      </p>
    </TerminalWindow>

    {!activeCat && (
      <div class="cat-grid">
        {CATS.map((c) => {
          const n = tools.filter((t) => t.data.category === c.key).length;
          return (
            <a class="cat-card card" href={withBase(`/toolbox/?cat=${c.key}`)}>
              <span class="cc-icon mono" aria-hidden="true">{c.icon}</span>
              <h3 class="cc-title">{c.label}</h3>
              <p class="cc-desc">{c.desc}</p>
              <span class="cc-count mono">{n} 个</span>
            </a>
          );
        })}
      </div>
    )}

    {activeCat && (
      <div class="cat-detail">
        <nav class="crumbs mono">
          <a href={withBase('/toolbox/')}>← 全部分类</a>
        </nav>
        <h2 class="cd-title"><span class="mono" aria-hidden="true">{activeCat.icon}</span> {activeCat.label} <span class="cd-count mono">{items.length} 个</span></h2>
        <div class="tb-grid">
          {items.map((t) => (
            <article class="tool-card card">
              {t.data.image && <img class="tool-img" src={t.data.image} alt="" loading="lazy" />}
              <div class="tool-body">
                <h3 class="tool-name">
                  {t.data.url
                    ? <a href={t.data.url} target="_blank" rel="noopener noreferrer">{t.data.name} <span class="mono ext" aria-hidden="true">↗</span></a>
                    : t.data.name}
                </h3>
                <p class="tool-desc">{t.data.description}</p>
                {t.data.install && <p class="tool-install mono">安装：{t.data.install}</p>}
              </div>
            </article>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .toolbox-page { padding: 48px 0 20px; display: flex; flex-direction: column; gap: 32px; }
  .kicker { font-size: 13px; color: var(--gold); margin: 0 0 10px; }
  .tb-title { margin: 0 0 8px; font-size: clamp(26px, 4vw, 38px); }
  .tb-sub { margin: 0; max-width: 640px; }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; }
  .cat-card { padding: 20px 22px; color: var(--text); display: flex; flex-direction: column; gap: 6px; }
  .cat-card:hover { text-decoration: none; }
  .cc-icon { font-size: 24px; color: var(--gold); }
  .cc-title { margin: 0; font-size: 18px; }
  .cc-desc { margin: 0; font-size: 13px; color: var(--text-muted); flex: 1; }
  .cc-count { font-size: 12px; color: var(--text-faint); }

  .crumbs { font-size: 13px; margin-bottom: 16px; }
  .crumbs a { color: var(--gold-soft); }
  .cd-title { margin: 0 0 20px; font-size: 24px; display: flex; align-items: center; gap: 10px; }
  .cd-count { font-size: 14px; color: var(--text-faint); }
  .tb-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
  .tool-card { overflow: hidden; display: flex; flex-direction: column; }
  .tool-img { width: 100%; height: 170px; object-fit: cover; object-position: top; border-bottom: 1px solid var(--line); }
  .tool-body { padding: 18px 20px 20px; }
  .tool-name { margin: 0 0 8px; font-size: 17px; }
  .tool-name a { color: var(--text); }
  .tool-name a:hover { color: var(--gold-soft); text-decoration: none; }
  .ext { font-size: 12px; color: var(--gold); }
  .tool-desc { margin: 0; font-size: 14px; color: var(--text-muted); line-height: 1.7; }
  .tool-install { margin-top: 8px; font-size: 12px; color: var(--gold-soft); border-top: 1px dashed var(--line); padding-top: 8px; }
</style>
