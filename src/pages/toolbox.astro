---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminalWindow from '../components/TerminalWindow.astro';

const tools = (await getCollection('tools')).sort((a, b) => a.data.order - b.data.order);

const CATS = [
  { key: 'class', label: '班级管理', icon: '▦', desc: '班主任工具 + 留痕 + 排座' },
  { key: 'teaching', label: '教学', icon: '▶', desc: '课件 + 中考题 + 上课提醒' },
  { key: 'agent', label: 'Agent / 知识库', icon: '◇', desc: 'Obsidian + WorkBuddy' },
  { key: 'skill', label: 'Skill / 脚本', icon: '◈', desc: '画图 + 飞象 + Mermaid' },
  { key: 'creation', label: '创作辅助', icon: '</>', desc: '网页工具 + 练习册 + 课件' },
  { key: 'design', label: '设计美学', icon: '✦', desc: '配色 + 图标 + 站酷 + shadcn' },
  { key: 'learn', label: '进阶学习', icon: '»', desc: 'easy-vibe + MDN + Dify' },
] as const;
---
<BaseLayout title="工具箱" description="班主任工具、教学工具、Skill 脚本、设计资源——按分类浏览">
  <div class="container toolbox-page">
    <TerminalWindow title="happyvibe toolbox">
      <p class="kicker mono">// TOOLBOX · {tools.length} 个工具 · {CATS.length} 个分类</p>
      <h1 class="tb-title">工具箱</h1>
      <p class="tb-sub text-muted">
        原则不变：<strong>大量重复、有固定流程的活才交给工具</strong>；涉及学生信息的界面分享前请脱敏。
      </p>
    </TerminalWindow>

    <!-- 分类导航 -->
    <nav class="cat-bar" id="cat-bar">
      {CATS.map((c) => {
        const n = tools.filter((t) => t.data.category === c.key).length;
        return (
          <button class="cat-chip" data-cat={c.key} type="button">
            <span class="mono" aria-hidden="true">{c.icon}</span> {c.label} <span class="cat-n mono">{n}</span>
          </button>
        );
      })}
    </nav>

    <!-- 分类详情（按需显示） -->
    {CATS.map((c) => {
      const items = tools.filter((t) => t.data.category === c.key);
      return (
        <section class="cat-detail" data-detail={c.key} hidden>
          <h2 class="cd-title"><span class="mono" aria-hidden="true">{c.icon}</span> {c.label} <span class="cd-count mono">{items.length} 个</span></h2>
          <div class="tb-grid">
            {items.map((t) => (
              <article class="tool-card card">
                {t.data.image && <img class="tool-img" src={t.data.image} alt="" loading="lazy" />}
                <div class="tool-body">
                  <h3 class="tool-name">
                    {t.data.url
                      ? <a href={t.data.url} target="_blank" rel="noopener noreferrer">{t.data.name} <span class="mono ext" aria-hidden="true">↗</span></a>
                      : t.data.name}
                  </h3>
                  <p class="tool-desc">{t.data.description}</p>
                  {t.data.install && <p class="tool-install mono">安装：{t.data.install}</p>}
                </div>
              </article>
            ))}
          </div>
        </section>
      );
    })}

    <!-- 默认总览 -->
    <div class="cat-overview" data-overview>
      {CATS.map((c) => {
        const items = tools.filter((t) => t.data.category === c.key);
        return (
          <div class="cat-row card">
            <button class="cat-row-head" data-cat={c.key} type="button">
              <span class="mono" aria-hidden="true">{c.icon}</span>
              <h3>{c.label}</h3>
              <span class="mono cat-n">{items.length} 个 →</span>
            </button>
          </div>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .toolbox-page { padding: 48px 0 20px; display: flex; flex-direction: column; gap: 28px; }
  .kicker { font-size: 13px; color: var(--gold); margin: 0 0 10px; }
  .tb-title { margin: 0 0 8px; font-size: clamp(26px, 4vw, 38px); }
  .tb-sub { margin: 0; max-width: 640px; }

  .cat-bar { display: flex; gap: 8px; flex-wrap: wrap; position: sticky; top: calc(var(--header-h) + 8px); z-index: 20;
    padding: 10px; background: rgba(21,14,34,.9); backdrop-filter: blur(10px); border-radius: 10px; border: 1px solid var(--line); }
  .cat-chip { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 8px;
    border: 1px solid var(--line-strong); background: var(--bg-panel); color: var(--text-muted);
    font-size: 13.5px; cursor: pointer; font-family: var(--sans); }
  .cat-chip:hover { border-color: var(--gold); color: var(--text); }
  .cat-chip.on { background: linear-gradient(135deg, var(--gold-soft), var(--gold)); color: #2a1c00; border-color: transparent; font-weight: 700; }
  .cat-n { font-size: 11px; opacity: .7; }

  .cat-overview { display: flex; flex-direction: column; gap: 10px; }
  .cat-row { padding: 0; overflow: hidden; }
  .cat-row-head { width: 100%; display: flex; align-items: center; gap: 14px; padding: 18px 22px;
    background: none; border: 0; color: var(--text); cursor: pointer; font-size: 15px; font-family: var(--sans); text-align: left; }
  .cat-row-head .mono { font-size: 20px; color: var(--gold); }
  .cat-row-head h3 { margin: 0; flex: 1; font-size: 17px; }
  .cat-row-head:hover { background: rgba(166,61,151,.08); }
  .cat-row-head:hover .cat-n { color: var(--gold-soft); }

  .cat-detail { display: flex; flex-direction: column; gap: 16px; }
  .cd-title { margin: 0; font-size: 22px; display: flex; align-items: center; gap: 10px; }
  .cd-count { font-size: 14px; color: var(--text-faint); }

  .tb-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 16px; }
  .tool-card { overflow: hidden; display: flex; flex-direction: column; }
  .tool-img { width: 100%; height: 170px; object-fit: cover; object-position: top; border-bottom: 1px solid var(--line); }
  .tool-body { padding: 18px 20px 20px; }
  .tool-name { margin: 0 0 8px; font-size: 17px; }
  .tool-name a { color: var(--text); }
  .tool-name a:hover { color: var(--gold-soft); text-decoration: none; }
  .ext { font-size: 12px; color: var(--gold); }
  .tool-desc { margin: 0; font-size: 14px; color: var(--text-muted); line-height: 1.7; }
  .tool-install { margin-top: 8px; font-size: 12px; color: var(--gold-soft); border-top: 1px dashed var(--line); padding-top: 8px; }
</style>

<script>
  const bar = document.getElementById('cat-bar')!;
  const overview = document.querySelector('[data-overview]')!;
  const chips = [...bar.querySelectorAll<HTMLButtonElement>('.cat-chip')];
  const details = [...document.querySelectorAll<HTMLElement>('[data-detail]')];

  function show(key: string | null) {
    chips.forEach((c) => c.classList.toggle('on', c.dataset.cat === key));
    details.forEach((d) => {
      d.hidden = d.dataset.detail !== key;
    });
    overview.hidden = !!key;
    // 更新 URL hash
    if (key) history.replaceState(null, '', '#' + key);
    else history.replaceState(null, '', location.pathname);
  }

  chips.forEach((c) => c.addEventListener('click', () => show(c.dataset.cat === chips.find((x) => x.classList.contains('on'))?.dataset.cat ? null : c.dataset.cat ?? null)));
  document.querySelectorAll('[data-cat][data-detail]') // no-op selector guard

  // 总览行点击 → 进入对应分类
  document.querySelectorAll<HTMLButtonElement>('.cat-row-head').forEach((b) => {
    b.addEventListener('click', () => {
      show(b.dataset.cat ?? null);
      bar.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  });
  // 芯片再点一次 = 返回
  chips.forEach((c) => c.addEventListener('click', () => {
    if (c.classList.contains('on')) show(null);
  }));

  // 初始 hash
  const h = location.hash.slice(1);
  if (h && details.some((d) => d.dataset.detail === h)) show(h);
</script>
