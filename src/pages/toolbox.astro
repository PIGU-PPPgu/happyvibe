---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminalWindow from '../components/TerminalWindow.astro';

const tools = (await getCollection('tools')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  tools.map(async (t) => ({ ...t, Content: (await render(t)).Content }))
);

const CATS = [
  { key: 'class', label: '班级管理', icon: '▦' },
  { key: 'teaching', label: '教学', icon: '▶' },
  { key: 'agent', label: 'Agent / 知识库', icon: '🦞' },
  { key: 'creation', label: '创作辅助', icon: '</>' },
] as const;
---
<BaseLayout title="工具箱" description="培训里推荐过的班主任工具、教学工具与创作辅助工具合集">
  <div class="container toolbox-page">
    <TerminalWindow title="happyvibe toolbox — 8 tools">
      <h1 class="tb-title">工具箱</h1>
      <p class="tb-sub text-muted">
        培训里推荐过的工具都在这里。原则不变：<strong>大量重复、有固定流程的活才交给工具</strong>；所有涉及学生信息的界面，分享前请脱敏。
      </p>
    </TerminalWindow>

    {CATS.map((cat) => {
      const items = rendered.filter((t) => t.data.category === cat.key);
      if (!items.length) return null;
      return (
        <section class="tb-cat">
          <h2 class="tb-cat-title"><span class="mono" aria-hidden="true">{cat.icon}</span> {cat.label}</h2>
          <div class="tb-grid">
            {items.map((t) => (
              <article class="tool-card card">
                {t.data.image && <img class="tool-img" src={t.data.image} alt="" loading="lazy" width="1100" height="620" />}
                <div class="tool-body">
                  <h3 class="tool-name">
                    {t.data.url
                      ? <a href={t.data.url} target="_blank" rel="noopener noreferrer">{t.data.name} <span class="mono ext" aria-hidden="true">↗</span></a>
                      : t.data.name}
                  </h3>
                  <p class="tool-desc">{t.data.description}</p>
                  {t.body && <div class="tool-note"><t.Content /></div>}
                </div>
              </article>
            ))}
          </div>
        </section>
      );
    })}
  </div>
</BaseLayout>

<style>
  .toolbox-page { padding: 48px 0 20px; display: flex; flex-direction: column; gap: 40px; }
  .tb-title { margin: 0 0 10px; font-size: clamp(26px, 4vw, 38px); }
  .tb-sub { margin: 0; max-width: 640px; }
  .tb-cat-title { margin: 0 0 16px; font-size: 20px; display: flex; gap: 10px; align-items: center; }
  .tb-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
  .tool-card { overflow: hidden; display: flex; flex-direction: column; }
  .tool-img { width: 100%; height: 170px; object-fit: cover; object-position: top; border-bottom: 1px solid var(--line); }
  .tool-body { padding: 18px 20px 20px; }
  .tool-name { margin: 0 0 8px; font-size: 17px; }
  .tool-name a { color: var(--text); }
  .tool-name a:hover { color: var(--gold-soft); text-decoration: none; }
  .ext { font-size: 12px; color: var(--gold); }
  .tool-desc { margin: 0; font-size: 14px; color: var(--text-muted); line-height: 1.7; }
  .tool-note { margin-top: 10px; font-size: 13px; color: var(--text-faint); border-top: 1px dashed var(--line); padding-top: 10px; }
</style>
