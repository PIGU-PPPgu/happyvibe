---
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminalWindow from '../components/TerminalWindow.astro';
import { MODULES } from '../data/modules';

const moduleNames: Record<string, string> = Object.fromEntries(
  MODULES.map((m) => [m.slug, `${m.code} ${m.title}`])
);
---
<BaseLayout title="数据看板" description="你在这个学习站的浏览量、学习天数、板块分布和访问时段——数据只存在你的浏览器里。">
  <div class="container an-page">
    <TerminalWindow title="happyvibe analytics — local only">
      <p class="kicker mono">// ANALYTICS · 只统计这台浏览器打开过的页面</p>
      <h1 class="title">数据看板</h1>
      <p class="sub text-muted">
        每次打开一个页面，这里就记一笔。数据全部存在你自己的浏览器里，不上传、不联网、换台电脑互不相通——这是一份只属于你的学习足迹。
      </p>
    </TerminalWindow>

    <section class="an-controls" aria-label="时间范围">
      <div class="seg" role="group" aria-label="统计范围">
        <button type="button" class="seg-btn" data-range="7">近 7 天</button>
        <button type="button" class="seg-btn" data-range="30">近 30 天</button>
        <button type="button" class="seg-btn is-on" data-range="all">全部</button>
      </div>
      <button type="button" class="ghost-btn" data-refresh>刷新</button>
    </section>

    <p class="empty-note card" data-empty hidden>
      还没有任何记录。从现在起，你每打开一个页面这里就会记一笔；刚打开的这页已经在数了，点「刷新」看看。
    </p>

    <section class="kpi-grid" aria-label="核心数据">
      <div class="kpi card">
        <p class="k-label">浏览量</p>
        <p class="k-num mono" data-k-pv>0</p>
        <p class="k-sub text-muted" data-k-pv-sub>范围内打开过 0 个页面</p>
      </div>
      <div class="kpi card">
        <p class="k-label">学习天数</p>
        <p class="k-num mono" data-k-days>0</p>
        <p class="k-sub text-muted" data-k-days-sub>连续 0 天</p>
      </div>
      <div class="kpi card">
        <p class="k-label">日均浏览</p>
        <p class="k-num mono" data-k-avg>0</p>
        <p class="k-sub text-muted">按有记录的天数平均</p>
      </div>
      <div class="kpi card">
        <p class="k-label">已学课程</p>
        <p class="k-num mono" data-k-done>0%</p>
        <p class="k-sub text-muted" data-k-done-sub>0 / 0 节</p>
      </div>
    </section>

    <section class="charts">
      <div class="chart card">
        <h2 class="c-title">板块浏览分布</h2>
        <div class="bars" data-bars-bucket></div>
      </div>
      <div class="chart card">
        <h2 class="c-title">常看页面</h2>
        <div class="bars" data-bars-page></div>
      </div>
    </section>

    <section class="card heat-card">
      <div class="heat-head">
        <h2 class="c-title">访问时段</h2>
        <p class="heat-legend mono" aria-hidden="true">少 <span class="lg-chip"></span><span class="lg-chip"></span><span class="lg-chip"></span><span class="lg-chip"></span> 多</p>
      </div>
      <div class="heat-scroll">
        <div class="heat-grid" data-heat></div>
        <p class="heat-axis mono" aria-hidden="true"><span>0时</span><span>6时</span><span>12时</span><span>18时</span><span>23时</span></p>
      </div>
    </section>

    <section class="card foot-card">
      <h2 class="c-title">足迹节点</h2>
      <ol class="tl" data-timeline></ol>
    </section>

    <p class="privacy text-muted">
      记录内容只有「打开时间 + 页面路径」，不含任何个人信息；清空只删访问记录，学习进度不受影响。
      <button type="button" class="ghost-btn" data-clear>清空访问记录</button>
    </p>
  </div>
</BaseLayout>

<script type="application/json" id="hv-module-names" set:html={JSON.stringify(moduleNames)} />

<style>
  .an-page { padding: 48px 0 20px; display: flex; flex-direction: column; gap: 20px; }
  .kicker { font-size: 13px; color: var(--gold); margin: 0 0 10px; }
  .title { margin: 0 0 8px; font-size: clamp(26px, 4vw, 38px); }
  .sub { margin: 0; line-height: 1.9; max-width: 640px; }

  .an-controls { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .seg { display: inline-flex; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
  .seg-btn {
    padding: 7px 16px; background: var(--bg-panel); border: 0; border-right: 1px solid var(--line);
    color: var(--text-muted); font-family: var(--sans); font-size: 13.5px; cursor: pointer;
  }
  .seg-btn:last-child { border-right: 0; }
  .seg-btn:hover { color: var(--text); }
  .seg-btn.is-on { background: rgba(254, 179, 0, 0.12); color: var(--gold-soft); }
  .ghost-btn {
    padding: 7px 14px; background: none; border: 1px solid var(--line); border-radius: 8px;
    color: var(--text-muted); font-family: var(--sans); font-size: 13.5px; cursor: pointer;
  }
  .ghost-btn:hover { border-color: var(--line-gold); color: var(--text); }

  .empty-note { margin: 0; padding: 14px 18px; color: var(--text-muted); line-height: 1.8; border-left: 3px solid var(--gold); }

  .kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .kpi { padding: 18px 20px 16px; display: flex; flex-direction: column; gap: 4px; }
  .k-label { margin: 0; font-size: 14px; color: var(--text-muted); }
  .k-num { margin: 2px 0 0; font-size: clamp(30px, 3.4vw, 42px); font-weight: 700; color: var(--gold); line-height: 1.1; }
  .k-sub { margin: 4px 0 0; font-size: 12.5px; }

  .charts { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .chart, .heat-card, .foot-card { padding: 20px 22px; }
  .c-title { margin: 0 0 14px; font-size: 17px; }
  .bars { display: flex; flex-direction: column; gap: 10px; }
  .b-row { display: grid; grid-template-columns: 118px 1fr 44px; align-items: center; gap: 10px; }
  .b-name { margin: 0; font-size: 13.5px; color: var(--text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .b-track { height: 10px; background: rgba(128, 128, 128, 0.12); border-radius: 5px; overflow: hidden; }
  .b-fill { display: block; height: 100%; background: linear-gradient(90deg, var(--purple-bright), var(--gold)); border-radius: 5px; }
  .b-num { margin: 0; font-size: 12.5px; color: var(--text-faint); text-align: right; }
  .b-zero { color: var(--text-faint); font-size: 13.5px; }

  .heat-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .heat-legend { margin: 0; font-size: 11.5px; color: var(--text-faint); display: inline-flex; align-items: center; gap: 4px; }
  .lg-chip { width: 12px; height: 12px; border-radius: 3px; display: inline-block; }
  .lg-chip:nth-child(2) { background: rgba(254, 179, 0, 0.18); }
  .lg-chip:nth-child(3) { background: rgba(254, 179, 0, 0.42); }
  .lg-chip:nth-child(4) { background: rgba(254, 179, 0, 0.68); }
  .lg-chip:nth-child(5) { background: rgba(254, 179, 0, 0.95); }
  .heat-scroll { overflow-x: auto; }
  .heat-grid { display: grid; grid-template-columns: 40px repeat(24, minmax(14px, 1fr)); gap: 3px; min-width: 620px; }
  .heat-rowlab { font-size: 12px; color: var(--text-faint); align-self: center; }
  .heat-cell { aspect-ratio: 1; border-radius: 3px; background: rgba(128, 128, 128, 0.1); }
  .heat-cell.h1 { background: rgba(254, 179, 0, 0.18); }
  .heat-cell.h2 { background: rgba(254, 179, 0, 0.42); }
  .heat-cell.h3 { background: rgba(254, 179, 0, 0.68); }
  .heat-cell.h4 { background: rgba(254, 179, 0, 0.95); }
  .heat-axis { display: flex; justify-content: space-between; margin: 6px 0 0 44px; font-size: 11px; color: var(--text-faint); }

  .tl { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .tl li { display: flex; align-items: baseline; gap: 12px; }
  .tl-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--gold); flex-shrink: 0; transform: translateY(-1px); }
  .tl li.tl-minor .tl-dot { background: var(--purple-bright); }
  .tl-main { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; }
  .tl-title { margin: 0; font-size: 15px; }
  .tl-time { margin: 0 0 0 auto; font-size: 12px; color: var(--text-faint); }

  .privacy { margin: 0; font-size: 13px; line-height: 2; max-width: 720px; }
  .privacy .ghost-btn { margin-left: 8px; }

  @media (max-width: 860px) {
    .kpi-grid { grid-template-columns: repeat(2, 1fr); }
    .charts { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .b-row { grid-template-columns: 92px 1fr 36px; }
    .k-num { font-size: 30px; }
  }
</style>

<script>
  import { getVisits, clearVisits } from '../lib/visits';
  import { countDone, getLessonIndex } from '../lib/progress';

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel);

  const PAGE_NAMES: Record<string, string> = {
    '/': '首页',
    '/modules/': '课程总览',
    '/path/': '学习路线图',
    '/pains/': '痛点对号入座',
    '/contest/': '比赛专区',
    '/toolbox/': '工具箱',
    '/challenge/': '21 天挑战',
    '/textbooks/': '教材索引',
    '/sitemap/': '站内地图',
    '/analytics/': '数据看板',
    '/facilitator/': '培训者工具包',
    '/workshop-script/': '授课逐字稿',
    '/about/': '关于本站',
  };

  const moduleNames = (() => {
    try {
      return JSON.parse(document.getElementById('hv-module-names')?.textContent || '{}') as Record<string, string>;
    } catch { return {}; }
  })();

  function pageName(p: string): string {
    if (PAGE_NAMES[p]) return PAGE_NAMES[p];
    const m = p.match(/^\/modules\/([a-z-]+)\/([a-z0-9-]+)\/?$/);
    if (m) {
      const lesson = getLessonIndex()[`${m[1]}/${m[2]}`];
      return lesson?.t || moduleNames[m[1]] || m[2];
    }
    const mod = p.match(/^\/modules\/([a-z-]+)\/?$/);
    if (mod) return moduleNames[mod[1]] || mod[1];
    return p.replace(/\/$/, '').split('/').pop() || p;
  }

  function bucketOf(p: string): string {
    if (p === '/') return '首页';
    if (p.startsWith('/modules/')) return '课程';
    if (p.startsWith('/path/')) return '学习路线图';
    if (p.startsWith('/pains/')) return '痛点';
    if (p.startsWith('/contest/')) return '比赛';
    if (p.startsWith('/toolbox/')) return '工具箱';
    return '其他';
  }

  const dayKey = (t: number) => new Date(t).toLocaleDateString('sv');
  const fmtDate = (t: number) => {
    const d = new Date(t);
    return `${d.getMonth() + 1} 月 ${d.getDate()} 日`;
  };
  const fmtTime = (t: number) => {
    const d = new Date(t);
    const p = (n: number) => String(n).padStart(2, '0');
    return `${fmtDate(t)} ${p(d.getHours())}:${p(d.getMinutes())}`;
  };
  function relTime(t: number): string {
    const s = Math.floor((Date.now() - t) / 1000);
    if (s < 60) return '刚刚';
    if (s < 3600) return `${Math.floor(s / 60)} 分钟前`;
    if (s < 86400) return `${Math.floor(s / 3600)} 小时前`;
    if (s < 86400 * 2) return '昨天';
    if (s < 86400 * 30) return `${Math.floor(s / 86400)} 天前`;
    return fmtDate(t);
  }

  const WEEK = ['周一', '周二', '周三', '周四', '周五', '周六', '周日'];
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));

  function barRows(data: [string, number][], total: number): string {
    if (!data.length || total === 0) return '<p class="b-zero">这个范围还没有记录。</p>';
    return data
      .map(([name, n]) => {
        const w = Math.max(2, Math.round((n / total) * 100));
        return `<div class="b-row"><p class="b-name" title="${esc(name)}">${esc(name)}</p><div class="b-track"><span class="b-fill" style="width:${w}%"></span></div><p class="b-num">${n}</p></div>`;
      })
      .join('');
  }

  let range: '7' | '30' | 'all' = 'all';

  function render() {
    const all = getVisits();
    const cutoff = range === 'all' ? 0 : Date.now() - Number(range) * 86400_000;
    const visits = all.filter((v) => v.t >= cutoff);

    const empty = $('[data-empty]');
    if (empty) empty.hidden = all.length > 0;

    // 核心指标
    const pv = visits.length;
    const daySet = new Set(visits.map((v) => dayKey(v.t)));
    const days = daySet.size;
    const setPV = (sel: string, val: string) => { const el = $(sel); if (el) el.textContent = val; };
    setPV('[data-k-pv]', String(pv));
    setPV('[data-k-pv-sub]', `范围内打开过 ${pv} 个页面`);
    setPV('[data-k-days]', String(days));

    // 连续天数：从今天（或昨天）往前数有记录的连续自然日
    let streak = 0;
    const allDays = new Set(all.map((v) => dayKey(v.t)));
    {
      const cur = new Date();
      if (!allDays.has(dayKey(cur.getTime()))) cur.setDate(cur.getDate() - 1); // 今天还没来过，从昨天起算
      while (allDays.has(dayKey(cur.getTime()))) {
        streak++;
        cur.setDate(cur.getDate() - 1);
      }
    }
    const first = all[0];
    setPV('[data-k-days-sub]', `${streak > 0 ? `连续 ${streak} 天` : '还没开始连续'}${first ? ` · 首访 ${fmtDate(first.t)}` : ''}`);
    setPV('[data-k-avg]', days ? (pv / days).toFixed(1) : '0');

    // 已学课程（与全站进度同源）
    const ids = Object.keys(getLessonIndex());
    const done = countDone(ids);
    setPV('[data-k-done]', ids.length ? `${Math.round((done / ids.length) * 100)}%` : '0');
    setPV('[data-k-done-sub]', `${done} / ${ids.length} 节`);

    // 板块分布 + 常看页面
    const buckets = new Map<string, number>();
    const pages = new Map<string, number>();
    for (const v of visits) {
      const b = bucketOf(v.p);
      buckets.set(b, (buckets.get(b) || 0) + 1);
      const name = pageName(v.p);
      pages.set(name, (pages.get(name) || 0) + 1);
    }
    const barB = $('[data-bars-bucket]');
    if (barB) barB.innerHTML = barRows([...buckets.entries()].sort((a, b) => b[1] - a[1]), pv);
    const barP = $('[data-bars-page]');
    if (barP) barP.innerHTML = barRows([...pages.entries()].sort((a, b) => b[1] - a[1]).slice(0, 7), pv);

    // 热力图 星期 × 小时
    const grid = new Array(7 * 24).fill(0);
    for (const v of visits) {
      const d = new Date(v.t);
      grid[((d.getDay() + 6) % 7) * 24 + d.getHours()]++;
    }
    const max = Math.max(1, ...grid);
    const heat = $('[data-heat]');
    if (heat) {
      let html = '';
      for (let dow = 0; dow < 7; dow++) {
        html += `<span class="heat-rowlab">${WEEK[dow]}</span>`;
        for (let h = 0; h < 24; h++) {
          const n = grid[dow * 24 + h];
          const lvl = n === 0 ? '' : n / max > 0.66 ? 'h4' : n / max > 0.33 ? 'h3' : n / max > 0.12 ? 'h2' : 'h1';
          html += `<span class="heat-cell ${lvl}" title="${WEEK[dow]} ${h}时 · ${n} 次"></span>`;
        }
      }
      heat.innerHTML = html;
    }

    // 足迹节点
    const tl = $('[data-timeline]');
    if (tl) {
      const todayKey = dayKey(Date.now());
      const todayCount = all.filter((v) => dayKey(v.t) === todayKey).length;
      const recent = [...all].slice(-6).reverse();
      const items: string[] = [];
      if (first) items.push(`<li><span class="tl-dot"></span><div class="tl-main"><p class="tl-title">第一次来 · ${fmtDate(first.t)}</p></div><p class="tl-time mono">${fmtTime(first.t)}</p></li>`);
      items.push(`<li><span class="tl-dot"></span><div class="tl-main"><p class="tl-title">今天已浏览 ${todayCount} 个页面</p></div><p class="tl-time mono">${relTime(Date.now())}</p></li>`);
      for (const v of recent) {
        items.push(`<li class="tl-minor"><span class="tl-dot"></span><div class="tl-main"><p class="tl-title">${esc(pageName(v.p))}</p></div><p class="tl-time mono">${relTime(v.t)}</p></li>`);
      }
      tl.innerHTML = items.join('');
    }
  }

  document.querySelectorAll<HTMLButtonElement>('[data-range]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-range]').forEach((b) => b.classList.remove('is-on'));
      btn.classList.add('is-on');
      range = btn.dataset.range as '7' | '30' | 'all';
      render();
    });
  });

  $('[data-refresh]')?.addEventListener('click', render);

  $('[data-clear]')?.addEventListener('click', () => {
    if (confirm('确定清空访问记录？学习进度不受影响。')) {
      clearVisits();
      render();
    }
  });

  render();
</script>
