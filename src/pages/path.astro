---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminalWindow from '../components/TerminalWindow.astro';
import { PATH_STATIONS } from '../data/path';
import PreTest from '../components/PreTest.astro';
import { withBase } from '../lib/urls';

// 校验路线图里的课程 ID 都真实存在
const lessons = await getCollection('lessons');
const minMap = new Map(lessons.map(l => [l.data.module + '/' + l.id.split('/').pop(), l.data.minutes ?? 0]));
const validIds = new Set(lessons.map((l) => `${l.data.module}/${l.id.split('/').pop()}`));
const stations = PATH_STATIONS.map((s) => ({
  ...s,
  lessons: s.lessons.map((l) => ({
    ...l,
    href: withBase(`/modules/${l.id}/`),
    min: minMap.get(l.id) ?? 0,
    missing: !validIds.has(l.id),
  })),
}));
const totalStations = stations.length;
---
<BaseLayout title="学习路线图" description="从会用 AI 到形成成果的七站成长路径">
  <div class="container path-page">
    <TerminalWindow title="happyvibe path — 7 stations">
      <p class="path-kicker mono">// GROWTH PATH · 源自培训成长路径图</p>
      <h1 class="path-title">七站，从「会用」到「形成成果」</h1>
      <p class="path-sub text-muted">
        <b style="color:var(--gold-soft)">不用纠结先学哪个：</b>
        路线图就是<b style="color:var(--gold-soft)">推荐的学习顺序</b>——从第 1 站开始，一站一站往下走；
        每一站里标出的课程，学完自动进入下一站。首页的模块库是「内容仓库」，路线图是「导游」。
      </p>
    </TerminalWindow>

    <div class="path-map-embed">
      <iframe class="path-frame" src="/interactives/path-map" title="七站路线图" loading="lazy"></iframe>
      <p class="path-full"><a href="/interactives/path-map" target="_blank" rel="noopener">全屏打开 →</a> <span class="mono text-muted">投屏时按 F 进演示模式</span></p>
    </div>

    <PreTest />

    <ol class="stations">
      {stations.map((s, i) => (
        <li class="station" data-station={s.code}>
          <div class="st-node" aria-hidden="true">
            <span class="st-num mono">{s.code}</span>
          </div>
          <div class="st-body card">
            <header class="st-head">
              <h2 class="st-title">{s.title}</h2>
              <span class="st-progress mono" data-station-pct={s.code}></span><span class="st-min mono">约 {s.lessons.reduce((a: number, l: any) => a + l.min, 0)} 分钟</span>
            </header>
            <div class="st-stages">
              <div class="stage now"><span class="sg-label">现在的你</span><span class="sg-text">{s.now}</span></div>
              <div class="stage doit"><span class="sg-label">带你做</span><span class="sg-text">{s.do}</span></div>
              <div class="stage gain"><span class="sg-label">你最终能获得</span><span class="sg-text">{s.gain}</span></div>
            </div>
            {s.artifact && (
              <div class="st-artifact">
                <p class="sa-title mono">// 本站毕业作品：{s.artifact.name}</p>
                <ul>{s.artifact.criteria.map((c) => <li>{c}</li>)}</ul>
              </div>
            )}
            <ul class="st-lessons">
              {s.lessons.map((l) => (
                <li>
                  <a class="st-link" href={l.href} data-lesson-link={l.id}>
                    <span class="st-check mono" aria-hidden="true">✓</span>
                    {l.title}
                  </a>
                </li>
              ))}
            </ul>
            {i < totalStations - 1 && <span class="st-arrow mono" aria-hidden="true">↓</span>}
          </div>
        </li>
      ))}
    </ol>

    <div class="path-finish card">
      <div>
        <p class="pf-title mono">// ALL STATIONS CLEARED</p>
        <p class="pf-text">走完七站？去 <a href={withBase('/modules/creation/task-library/')}>任务库</a> 挑一个真实任务练手——把学会的东西立刻变成作品。</p>
      </div>
      <a class="btn btn-gold" href={withBase('/modules/creation/task-library/')}>去任务库 →</a>
    </div>
  </div>
</BaseLayout>

<style>
  .path-page { padding: 48px 0 20px; }
  .path-kicker { font-size: 13px; color: var(--gold); margin: 0 0 10px; }
  .path-title { margin: 0 0 10px; font-size: clamp(24px, 4vw, 36px); }
  .path-sub { margin: 0; max-width: 620px; }
  .path-map-embed { margin-top: 24px; }
  .path-frame { width: 100%; aspect-ratio: 880 / 620; border: 1px solid var(--line); border-radius: 12px; background: var(--bg-panel); }
  .path-full { margin: 8px 0 0; font-size: 13px; }
  .path-full a { color: var(--gold-soft); border-bottom: 1px dashed var(--line-gold); }
  @media (max-width: 700px) { .path-frame { aspect-ratio: auto; height: 520px; } }
  .path-finish {
    margin-top: 36px; padding: 24px 28px;
    display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap;
  }
  .pf-title { font-size: 12px; color: var(--gold); letter-spacing: .12em; margin: 0 0 6px; }
  .pf-text { margin: 0; max-width: 520px; }
  .stations {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
    position: relative;
  }
  .station { display: flex; gap: 20px; }
  .st-node {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-panel);
    border: 2px solid var(--line-strong);
    border-radius: 0;
    box-shadow: 3px 3px 0 rgba(166, 61, 151, 0.35);
  }
  .st-num { font-size: 16px; font-weight: 700; color: var(--gold); }
  .st-body { flex: 1; padding: 20px 24px; position: relative; }
  .st-head { display: flex; align-items: baseline; gap: 12px; }
  .st-title { margin: 0; font-size: 20px; }
  .st-progress { margin-left: auto; font-size: 12px; color: var(--gold-soft); }
  .st-stages { display: grid; grid-template-columns: 1fr; gap: 8px; margin: 10px 0 14px; }
  @media (min-width: 720px) { .st-stages { grid-template-columns: 1fr 1.4fr 1fr; } }
  .stage { border-radius: 8px; padding: 10px 12px; }
  .stage.now { background: rgba(150, 140, 160, .1); }
  .stage.doit { background: rgba(166, 61, 151, .14); }
  .stage.gain { background: rgba(254, 179, 0, .1); }
  .sg-label { display: block; font-size: 11px; letter-spacing: .08em; color: var(--text-faint); margin-bottom: 3px; font-family: var(--mono); }
  .stage.now .sg-label { color: #a094b8; }
  .stage.doit .sg-label { color: var(--purple-soft); }
  .stage.gain .sg-label { color: var(--gold); }
  .sg-text { font-size: 14px; line-height: 1.6; color: var(--text); display: block; }
  .st-artifact { margin: 12px 0; padding: 12px 16px; border: 1px dashed var(--line-gold); border-radius: 10px; background: rgba(254, 179, 0, .06); }
  .st-artifact .sa-title { font-size: 12px; color: var(--gold); margin: 0 0 8px; letter-spacing: .05em; }
  .st-artifact ul { margin: 0; padding-left: 1.2em; }
  .st-artifact li { font-size: 13px; line-height: 1.9; color: var(--text-muted); }
  .st-lessons { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .st-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text);
    font-size: 14.5px;
    padding: 6px 12px;
    border: 1px dashed var(--line);
    border-radius: var(--radius-sm);
  }
  .st-link:hover { border-color: var(--line-gold); color: var(--gold-soft); text-decoration: none; }
  .st-check { color: var(--text-faint); visibility: hidden; }
  .st-link.is-done .st-check { visibility: visible; color: var(--gold); }
  .st-link.is-done { border-style: solid; border-color: var(--line-gold); }
  .st-arrow {
    position: absolute;
    bottom: -34px;
    left: 24px;
    color: var(--purple-soft);
    font-size: 18px;
    animation: float-y 2s ease-in-out infinite;
  }
  @media (min-width: 820px) {
    .station { padding-left: 12px; }
  }
</style>

<script>
  import { getDoneMap, onProgress } from '../lib/progress';

  function refresh() {
    const done = getDoneMap();
    document.querySelectorAll<HTMLElement>('[data-station]').forEach((st) => {
      const code = st.getAttribute('data-station')!;
      const links = [...st.querySelectorAll<HTMLAnchorElement>('[data-lesson-link]')];
      let n = 0;
      links.forEach((a) => {
        const id = a.getAttribute('data-lesson-link')!;
        const isDone = Boolean(done[id]);
        a.classList.toggle('is-done', isDone);
        if (isDone) n += 1;
      });
      const pctEl = st.querySelector<HTMLElement>(`[data-station-pct="${code}"]`);
      if (pctEl) pctEl.textContent = `${n}/${links.length} 已学`;
      const node = st.querySelector<HTMLElement>('.st-node');
      if (node) node.style.borderColor = n === links.length && links.length > 0 ? 'var(--gold)' : 'var(--line-strong)';
    });
  }
  refresh();
  onProgress(refresh);
</script>
