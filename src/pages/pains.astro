---
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminalWindow from '../components/TerminalWindow.astro';
import Mermaid from '../components/Mermaid.astro';
import { withBase } from '../lib/urls';

interface Pain {
  text: string;
  fix: string;
  href: string;
  effect: string;
}

interface Group {
  id: string;
  title: string;
  nature: string;
  pains: Pain[];
}

const GROUPS: Group[] = [
  {
    id: 'tips',
    title: '指尖上的负担',
    nature: '国家发过文要减的：打卡、截图、留痕',
    pains: [
      {
        text: '安全教育平台：群里催完打卡，截图还要一张一张收、一张一张核',
        fix: '批量核对汇总',
        href: '/modules/software/wb-06-office/',
        effect: '统计汇总这段交给 AI，规则你定',
      },
      {
        text: '政务 APP 打卡、接龙、点赞投票、传照片传轨迹',
        fix: '痛点拆解课',
        href: '/modules/growth/pain-breakdown/',
        effect: '制度减不掉的，工具至少省掉汇总那段',
      },
      {
        text: '晨午检表天天填、谁没到天天追原因',
        fix: '痛点拆解课',
        href: '/modules/growth/pain-breakdown/',
        effect: '一句话生成当日台账',
      },
      {
        text: '留痕材料，晚间和周末赶工',
        fix: '万事留痕',
        href: '/modules/class-management/trace-desk/',
        effect: '过程自动留档，材料自动成',
      },
    ],
  },
  {
    id: 'docs',
    title: '检查与台账',
    nature: '平时没人看，检查前一夜全来了',
    pains: [
      {
        text: '检查前一夜补 15 篇听课记录、补教案——手写三小时',
        fix: '痛点拆解课',
        href: '/modules/growth/pain-breakdown/',
        effect: '课堂要点整理成规范记录格式',
      },
      {
        text: '教案规定张数，教学反思不少于 500 字',
        fix: 'AI 辅助备课',
        href: '/modules/teaching/lesson-prep/',
        effect: '反思出初稿，你改成自己的话',
      },
      {
        text: '班主任手册、班会记录、家访记录，期末集中补',
        fix: '痛点拆解课',
        href: '/modules/growth/pain-breakdown/',
        effect: '平时一句话记，期末不补课',
      },
      {
        text: '帮社区、保险、银行统计学生户籍参保',
        fix: '三个痛点任务',
        href: '/modules/software/wb-06-office/',
        effect: '表格导进去，汇总自动出',
      },
    ],
  },
  {
    id: 'teaching',
    title: '教学循环',
    nature: '天天摸的活，最容易忽略它有多费',
    pains: [
      {
        text: '备一节好课：教学设计、课件、素材、案例，每样重搜一遍',
        fix: 'AI 辅助备课',
        href: '/modules/teaching/lesson-prep/',
        effect: '一次生成备课包，你改成自己的',
      },
      {
        text: '出卷：找题、拼卷、排版、答案、双向细目表',
        fix: '命题实战',
        href: '/modules/teaching/exam-paper-task/',
        effect: '做完手里有一份完整的卷',
      },
      {
        text: '一人带四个班，每个学生写三页，改到眼花',
        fix: '三个痛点任务',
        href: '/modules/software/wb-06-office/',
        effect: '批改后的统计提炼交给 AI',
      },
      {
        text: '登分：卷面分一个数一个数敲进 Excel',
        fix: '成绩分析与增值评价',
        href: '/modules/edu-data/grade-analysis/',
        effect: '拍照转表格，函数不用会',
      },
      {
        text: '成绩分析只会求平均分，排名、进步率、错题率无从下手',
        fix: '月考分析实战',
        href: '/modules/edu-data/exam-analysis-task/',
        effect: '一句话出全套分析',
      },
      {
        text: '讲评课凭感觉挑题，错题分布靠印象',
        fix: '数据可视化',
        href: '/modules/edu-data/visualization/',
        effect: '错题排序出来，讲评有靶子',
      },
    ],
  },
  {
    id: 'class',
    title: '班务管理',
    nature: '一个人的班主任，三个人的活',
    pains: [
      {
        text: '排座位：身高视力动静成绩全要配，家长还盯着黄金座位',
        fix: '排座课 + SEAT OS',
        href: '/modules/class-management/seat-planner/',
        effect: '规则你说了算，草案自动生成',
      },
      {
        text: '值日排班乱、学生不自觉、老师天天催',
        fix: '留痕进阶玩法',
        href: '/modules/class-management/trace-desk-advanced/',
        effect: '值日自动排班，表扬状批量出',
      },
      {
        text: '课间纪律事件，事后追记谁干了什么说不清',
        fix: '万事留痕',
        href: '/modules/class-management/trace-desk/',
        effect: '一句话记录，过程留档',
      },
      {
        text: '黑板报、班级文化布置，每学期换主题做手工',
        fix: '任务库',
        href: '/modules/creation/task-library/',
        effect: '主题方案和版式一句话出',
      },
    ],
  },
  {
    id: 'home',
    title: '家校沟通',
    nature: '最急的活，最不能出错的话',
    pains: [
      {
        text: '家长群「收到」要数，没回的要单独 @',
        fix: '副班主任',
        href: '/modules/class-management/co-teacher/',
        effect: '设一次，跑一学期',
      },
      {
        text: '家长消息 24 小时随时来，课间十分钟回不完 99+',
        fix: '教师智能体',
        href: '/modules/growth/teacher-agent/',
        effect: '按你的口径起草，你审后发',
      },
      {
        text: '学生出事当晚：群发告知、个别沟通、台账、跟进四份材料',
        fix: '留痕深度实战',
        href: '/modules/class-management/trace-desk/',
        effect: '一段话术生成四份，事实你出措辞它出',
      },
      {
        text: '期末几十条手写评语，一人一段不许重样，家长还会公开挑毛病',
        fix: '期末三大件流水线',
        href: '/modules/software/task-final-term/',
        effect: '素材三行进，草稿分维度出',
      },
      {
        text: '家长会：讲稿、数据展示、PPT，一学期磨一次',
        fix: '任务库 · 数据大屏',
        href: '/modules/creation/task-library/',
        effect: '数据滚动图表页一句话出',
      },
    ],
  },
  {
    id: 'young',
    title: '年轻老师特有',
    nature: '骨干路上额外压的担子',
    pains: [
      {
        text: '赛课磨课：教案改 20 版，课件一帧一帧抠',
        fix: '痛点拆解课',
        href: '/modules/growth/pain-breakdown/',
        effect: '评课意见整合、版本对比交给 AI',
      },
      {
        text: '师徒结对：一学期 15 节听课任务加记录',
        fix: '痛点拆解课',
        href: '/modules/growth/pain-breakdown/',
        effect: '记录格式化，整理不再熬夜',
      },
      {
        text: '职称材料：学时、证明、论文、年限，缺一样卡一年',
        fix: '痛点拆解课',
        href: '/modules/growth/pain-breakdown/',
        effect: '清单核对器，缺什么提前知道',
      },
    ],
  },
];
const painCount = GROUPS.reduce((a: number, g: Group) => a + g.pains.length, 0);
---
<BaseLayout title="痛点对号入座" description="老师每天被什么折磨：成绩统计、期末评语、课题申报、突发沟通、想给学生做东西——每个痛点都有一条现成的路。">
  <div class="container pains-page">
    <TerminalWindow title="happyvibe pain-mapping">
      <p class="kicker mono">// PAIN FIRST · 先认痛点，再谈 AI</p>
      <h1 class="title">你每天被什么折磨</h1>
      <p class="sub text-muted">
        培训从这页开始：被哪条折磨过的，举个手。<br>
        每条痛点右边就是站里的现成解法——<b style="color:var(--gold-soft)">今天不学概念，只解决你举手的那件事</b>。
      </p>
    </TerminalWindow>

    <div class="mindmap card">
      <h2>痛点全景</h2>
      <pre><code class="language-mermaid">
mindmap
  root((每天被什么折磨))
    指尖上的负担
      催打卡收截图
      接龙点赞留痕
      晨午检天天填
      留痕材料赶工
    检查与台账
      检查前补听课记录
      教案反思五百字
      手册记录期末补
      帮社区统计户籍参保
    教学循环
      备课每样重搜
      出卷排版
      四个班三页
      登分一个数一个数敲
      分析只会平均分
      讲评凭感觉
    班务管理
      排座位全家挪
      值日天天催
      纪律说不清
      黑板报换主题
    家校沟通
      收到要数
      消息回不完
      出事当晚四份材料
      评语不许重样
      家长会三件
    年轻老师特有
      赛课改二十版
      十五节听课任务
      职称缺一样卡一年
      </code></pre>
      <p class="mm-note text-muted">举手对号之后往下翻——每条痛点都链到站内解法。</p>
    </div>
    <Mermaid />

    <div class="ask card">
      <h2>拆解方法</h2>
      <p>这页只是靶子。挑一条你最恨的，去 <a href={withBase('/modules/growth/pain-breakdown/')}>痛点拆解课</a>：反问六问抠细节 → 四格拆解出话术 → 反向提问让 AI 出产品方案——今天培训讲的就是这条链。</p>
    </div>

    <div class="ask card">
      <h2>交给 AI 前的三问</h2>
      <p>拿你举手的那件事，过一遍这三问：</p>
      <ol>
        <li><b>大量重复？</b>——每学期都做、每次格式都一样。</li>
        <li><b>有固定流程？</b>——有模板、有套路、有章可循。</li>
        <li><b>要当面的人情？</b>——要你的判断、你的分寸、你的眼睛看着眼睛。</li>
      </ol>
      <p>前两问「是」、第三问「否」的活，交出去；第三问「是」的活，永远留给自己。<a href={withBase('/modules/basics/when-to-use/')}>这三问的来龙去脉</a>。</p>
    </div>

    {GROUPS.map((g) => (
      <section class="grp card">
        <header class="grp-head">
          <h2>{g.title}</h2>
          <span class="grp-nature text-muted">{g.nature}</span>
        </header>
        <ul class="pain-list">
          {g.pains.map((p) => (
            <li class="pain">
              <p class="p-text">{p.text}</p>
              <div class="p-fix">
                <a class="p-link" href={withBase(p.href)}>{p.fix} →</a>
                <span class="p-effect text-muted">{p.effect}</span>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <div class="more card">
      <h2>你的痛点不在这里</h2>
      <p>去<a href={withBase('/modules/creation/task-library/')}>任务库</a>按目标找——不按软件找，按你想解决的事找。还没有的，每课底部有「复制求助话术」，发到群里一起想办法。</p>
    </div>
  </div>
</BaseLayout>

<style>
  .pains-page { padding: 48px 0 20px; display: flex; flex-direction: column; gap: 22px; max-width: 860px; }
  .kicker { font-size: 13px; color: var(--gold); margin: 0 0 10px; }
  .title { margin: 0 0 8px; font-size: clamp(26px, 4vw, 38px); }
  .sub { margin: 0; line-height: 1.9; }
  .mindmap { padding: 22px 26px; }
  .mindmap h2 { font-size: 19px; color: var(--gold-soft); margin: 0 0 6px; }
  .mindmap pre { margin: 0; }
  .mm-note { margin: 10px 0 0; font-size: 13px; }
  .ask { padding: 22px 26px; border-color: var(--line-gold); background: rgba(254,179,0,.04); }
  .ask h2, .grp h2, .more h2 { font-size: 19px; color: var(--gold-soft); margin: 0 0 10px; }
  .ask ol { padding-left: 1.4em; margin: 8px 0; font-size: 15px; line-height: 2.1; }
  .ask p, .more p { margin: 4px 0; font-size: 14.5px; line-height: 1.9; }
  .ask a, .more a { color: var(--gold); }
  .grp { padding: 22px 26px; }
  .grp-head { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 8px; }
  .grp-nature { font-size: 13px; }
  .pain-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .pain { padding: 14px 0; border-bottom: 1px dashed var(--line); }
  .pain:last-child { border-bottom: 0; }
  .p-text { margin: 0 0 8px; font-size: 15.5px; line-height: 1.8; }
  .p-fix { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; }
  .p-link { color: var(--gold-soft); font-weight: 600; border-bottom: 1px dashed var(--line-gold); font-size: 14.5px; }
  .p-link:hover { color: var(--gold); }
  .p-effect { font-size: 13px; }
  .more { padding: 22px 26px; }
</style>
