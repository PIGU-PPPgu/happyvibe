---
import BaseLayout from '../layouts/BaseLayout.astro';
import ModuleCarousel from '../components/ModuleCarousel.astro';
import OnboardingTour from '../components/OnboardingTour.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/urls';

const lessons = await getCollection('lessons');
---
<BaseLayout>
  <section class="container hero">
    <p class="kicker mono">// HAPPYVIBE FOR TEACHERS · OPEN SOURCE</p>
    <h1 class="hero-title">给老师们的 <span class="hero-gold">AI</span> 学习站<br />开箱即用的开源框架</h1>
    <p class="hero-sub">
      课程模块、工具箱、全站搜索、本地进度、新手引导、数据看板——全部零依赖原生实现。
      写 Markdown 就是写课程，部署到 Cloudflare Pages 就是上线。
    </p>
    <div class="hero-cta">
      <a class="btn btn-gold" href={withBase('/modules/start/tour/')}>开始第 1 课 →</a>
      <a class="btn btn-ghost" href={withBase('/modules/')}>课程总览</a>
      <a class="btn btn-ghost" href="https://github.com/PIGU-PPPgu/happyvibe" target="_blank" rel="noopener">GitHub ↗</a>
    </div>
  </section>

  <ModuleCarousel />

  <section class="container entry-sec">
    <a class="card entry-card" href={withBase('/toolbox/')}>
      <div>
        <h2 class="e-title">工具箱</h2>
        <p class="e-sub text-muted">分类筛选与搜索，收录工具就是写一个 Markdown 文件。</p>
      </div>
      <span class="btn btn-gold">进去看 →</span>
    </a>
    <a class="card entry-card" href={withBase('/analytics/')}>
      <div>
        <h2 class="e-title">数据看板</h2>
        <p class="e-sub text-muted">接入 Cloudflare Web Analytics，访问次数、热门页面、时段热力图。</p>
      </div>
      <span class="btn btn-gold">进去看 →</span>
    </a>
  </section>

  <p class="container lessons-note mono text-muted">// {lessons.length} 节示例课 · 换成你自己的内容就是一个正式学习站</p>

  <OnboardingTour />
</BaseLayout>

<style>
  .hero { padding: 64px 0 32px; }
  .kicker { font-size: 13px; color: var(--gold); margin: 0 0 14px; }
  .hero-title { margin: 0 0 16px; font-size: clamp(30px, 5vw, 48px); line-height: 1.3; }
  .hero-gold { color: var(--gold); }
  .hero-sub { margin: 0 0 28px; color: var(--text-muted); max-width: 580px; line-height: 1.9; }
  .hero-cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .entry-sec { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 32px; }
  .entry-card { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 22px 24px; text-decoration: none; }
  .entry-card:hover { text-decoration: none; }
  .e-title { margin: 0 0 4px; font-size: 19px; }
  .e-sub { margin: 0; font-size: 14px; }
  .lessons-note { margin-top: 28px; font-size: 12.5px; }
  @media (max-width: 700px) { .entry-sec { grid-template-columns: 1fr; } }
</style>
