---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminalWindow from '../components/TerminalWindow.astro';
import TypeWriter from '../components/TypeWriter.astro';
import ModuleCarousel from '../components/ModuleCarousel.astro';
import OnboardingTour from '../components/OnboardingTour.astro';
import { MODULES } from '../data/modules';
import { withBase } from '../lib/urls';

const lessons = await getCollection('lessons');
const totalLessons = lessons.length;
const moduleCount = new Set(lessons.map((l) => l.data.module)).size;

const PAGES = [
  { name: '学习路线图', href: '/path/', note: '七站三段' },
  { name: '痛点对号入座', href: '/pains/', note: '20 条痛点对解法' },
  { name: '比赛专区', href: '/contest/', note: '四赛道' },
  { name: '工具箱', href: '/toolbox/', note: '29 个工具' },
  { name: '21 天挑战', href: '/challenge/', note: '每天 15 分钟' },
  { name: '教材索引', href: '/textbooks/', note: '1-9 年级课本页' },
  { name: '培训者工具包', href: '/facilitator/', note: '含授课脚本' },
  { name: '关于本站', href: '/about/', note: '' },
];

const moduleLessons = MODULES.map((m) => ({
  m,
  items: lessons.filter((l) => l.data.module === m.slug).sort((a, b) => a.data.order - b.data.order),
}));

const heroLines = [
  '$ happyvibe --start',
  '> 集团教师 AI 赋能学习站',
  '> 理念：AI 不该成为负担，用好 AI = 减负增效',
  '$ load modules ... done ✓',
];
---
<BaseLayout>
  <section class="container hero">
    <TerminalWindow title="happyvibe — zsh">
      <p class="hero-typo mono">
        <TypeWriter lines={heroLines} />
      </p>
      <h1 class="hero-title">
        <span class="hero-gold">每位老师都能用好 AI，减负增效。</span>
      </h1>
      <p class="hero-sub">
        这里整理了集团培训的全部内容：{totalLessons} 节课、{moduleCount} 个模块，
        从认识 AI 到做出自己的工具，按你的节奏学。
      </p>
      <div class="hero-cta">
        <a class="btn btn-gold" href={withBase('/modules/software/wb-01-start/')}>▶ 开始学习</a>
        <span class="hero-alt">
          <a href={withBase('/contest/')}>比赛专区</a> · <a href={withBase('/challenge/')}>21 天挑战</a> ·
          <a href={withBase('/toolbox/')}>工具箱</a> ·
          <button data-search-open type="button">搜索</button>
        </span>
      </div>
    </TerminalWindow>
  </section>

  <section class="container start-here">
    <h2 class="sh-title">从哪里开始？</h2>
    <div class="start-grid">
      <a class="start-card card" href={withBase('/modules/software/wb-01-start/')}>
        <h3 class="sc-t">我要直接上手一个工具</h3>
        <p class="sc-d">WorkBuddy 手把手六课。<span class="sc-tag mono">最推荐</span></p>
      </a>
      <a class="start-card card" href={withBase('/pains/')}>
        <h3 class="sc-t">我想解决一个具体问题</h3>
        <p class="sc-d">被什么折磨，就对号入座——每条痛点都有现成解法。</p>
      </a>
      <a class="start-card card" href={withBase('/path/')}>
        <h3 class="sc-t">我想系统学一遍</h3>
        <p class="sc-d">跟学习路线图走，从认知到做出作品，一站一站来。</p>
      </a>
    </div>
  </section>

  <ModuleCarousel />

  <section class="container continue-sec">
    <div class="continue-card card">
      <div>
        <h2 class="continue-title">继续学习</h2>
        <p class="continue-sub text-muted">从上次停下的地方接着来。</p>
        <p class="continue-lesson" data-continue-slot>加载中…</p>
      </div>
      <a class="btn btn-gold" href={withBase('/path/')} data-continue-btn hidden>去上课 →</a>
    </div>
  </section>

  <section class="container sitemap" id="sitemap">
    <header class="sec-head">
      <h2 class="sec-title">站内地图 <span class="mono sec-code">// 8 个页面 · 10 个模块 · {totalLessons} 节课</span></h2>
      <p class="sec-sub text-muted">整个站的结构在这两张图里：上面是总览，点节点聚焦、按 / 搜索；下面是目录树，点模块名展开课表，学过的课打金勾。</p>
    </header>

    <iframe class="site-frame" src="/interactives/site-map" title="站内地图" loading="lazy"></iframe>
    <p class="site-full"><a href="/interactives/site-map" target="_blank" rel="noopener">全屏打开 →</a></p>

    <div class="tree card">
      <p class="tree-root mono">~/happyvibe</p>
      <details class="tr-branch" open>
        <summary><span class="tr-name">页面</span><span class="tr-n mono">{PAGES.length}</span></summary>
        <ul class="tr-list">
          {PAGES.map((p) => (
            <li><a href={withBase(p.href)}>{p.name}{p.note && <span class="tr-note"> · {p.note}</span>}</a></li>
          ))}
        </ul>
      </details>
      <details class="tr-branch">
        <summary><span class="tr-name">modules · 课程模块</span><span class="tr-n mono">{moduleLessons.length} / {totalLessons}</span></summary>
        {moduleLessons.map(({ m, items }) => (
          <details class="tr-mod">
            <summary>
              <span class="tr-code mono">{m.code}</span>
              <span class="tr-name">{m.title}</span>
              <span class="tr-n mono">{items.length} 课</span>
            </summary>
            <ul class="tr-list">
              {items.map((l) => {
                const id = `${m.slug}/${l.id.split('/').pop()}`;
                return (
                  <li>
                    <a href={withBase(`/modules/${id}/`)} data-tree-lesson={id}>
                      <span class="tr-check mono" aria-hidden="true">✓</span>
                      <span class="tr-title">{l.data.title}</span>
                      {l.data.minutes && <span class="tr-min mono">{l.data.minutes} 分钟</span>}
                    </a>
                  </li>
                );
              })}
            </ul>
          </details>
        ))}
      </details>
    </div>
  </section>

  <OnboardingTour />
</BaseLayout>

<style>
  .hero { padding: 56px 0 24px; }
  .hero-typo { font-size: 14px; color: var(--purple-soft); min-height: 5.9em; margin: 0 0 18px; }
  .hero-title { margin: 0 0 14px; font-size: clamp(28px, 5vw, 46px); line-height: 1.3; }
  .hero-gold { color: var(--gold); }
  .hero-sub { margin: 0 0 26px; color: var(--text-muted); max-width: 560px; }
  .hero-cta { display: flex; gap: 16px; flex-wrap: wrap; align-items: center; }
  .hero-alt { font-size: 13.5px; color: var(--text-muted); display: inline-flex; gap: 8px; }
  .hero-alt a, .hero-alt button { color: var(--gold-soft); background: none; border: 0; cursor: pointer; font-size: 13.5px; padding: 0; }
  .start-here { margin-top: 52px; }
  .sh-title { font-size: 20px; margin: 0 0 16px; color: #ffd34d; }
  .start-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; }
  .start-card { padding: 20px 22px; color: var(--text); display: flex; flex-direction: column; gap: 6px; }
  .start-card:hover { text-decoration: none; }
  .sc-t { margin: 0; font-size: 17px; }
  .sc-d { margin: 0; font-size: 13.5px; color: var(--text-muted); line-height: 1.7; }
  .sc-tag { font-size: 11px; color: #2a1c00; background: linear-gradient(135deg, var(--gold-soft), var(--gold));
            border-radius: 4px; padding: 1px 8px; margin-left: 6px; font-weight: 700; }
  .sec-head { margin: 64px 0 24px; }
  .sec-title { margin: 0 0 6px; font-size: clamp(22px, 3vw, 30px); }
  .sec-code { font-size: 14px; color: var(--text-faint); font-weight: 400; }
  .sec-sub { margin: 0; }
  .module-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
  .module-card { padding: 22px; color: var(--text); display: flex; flex-direction: column; gap: 6px; }
  .module-card:hover { text-decoration: none; }
  .mc-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
  .mc-icon { font-size: 22px; font-family: var(--mono); }
  .mc-code { font-size: 13px; font-weight: 700; letter-spacing: 0.1em; }
  .mc-title { margin: 0; font-size: 19px; }
  .mc-sub { margin: 0 0 8px; font-size: 13.5px; color: var(--text-muted); flex: 1; }
  .mc-mode {
    align-self: flex-start; font-size: 11.5px; padding: 1px 9px; border-radius: 4px;
    border: 1px solid; opacity: .9;
  }
  .mc-foot { display: flex; align-items: center; gap: 10px; margin-top: 14px; }
  .mc-count { font-size: 12px; color: var(--text-faint); }
  .mc-bar { flex: 1; height: 6px; background: var(--bg-deep); border-radius: 3px; overflow: hidden; border: 1px solid var(--line); }
  .mc-bar-fill { height: 100%; width: 0; background: linear-gradient(90deg, var(--purple-bright), var(--gold)); transition: width 0.5s ease; }
  .mc-pct { font-size: 12px; color: var(--gold-soft); min-width: 34px; text-align: right; }
  .continue-sec { margin-block: 56px 20px; }
  .continue-card { padding: 26px 28px; display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .sitemap { margin-top: 64px; }
  .site-frame { width: 100%; aspect-ratio: 960 / 1000; border: 1px solid var(--line); border-radius: 12px; margin: 8px 0; background: var(--bg-panel); }
  .site-full { margin: 0 0 18px; font-size: 13px; }
  .site-full a { color: var(--gold-soft); border-bottom: 1px dashed var(--line-gold); }
  .tree { padding: 18px 22px; }
  .tree-root { margin: 0 0 8px; font-size: 13px; color: var(--gold); }
  .tree summary { cursor: pointer; display: flex; align-items: baseline; gap: 10px; padding: 8px 8px; border-radius: 6px; list-style: none; }
  .tree summary::-webkit-details-marker { display: none; }
  .tree summary::before { content: '▸'; color: var(--gold); font-size: 12px; transition: transform .15s; }
  .tree details[open] > summary::before { transform: rotate(90deg); }
  .tree summary:hover { background: rgba(254, 179, 0, .06); }
  .tr-name { font-size: 15px; font-weight: 600; }
  .tr-n { margin-left: auto; font-size: 12px; color: var(--text-faint); }
  .tr-code { font-size: 12px; color: var(--purple-soft); }
  .tr-list { list-style: none; margin: 0; padding: 2px 0 10px 26px; display: flex; flex-direction: column; gap: 4px; }
  .tr-list a { display: flex; align-items: baseline; gap: 8px; color: var(--text-muted); padding: 6px 8px; border-radius: 6px; font-size: 14.5px; }
  .tr-list a:hover { color: var(--gold-soft); background: var(--bg-panel); text-decoration: none; }
  .tr-note { color: var(--text-faint); font-size: 13px; }
  .tr-check { color: var(--text-faint); visibility: hidden; font-size: 13px; }
  .tr-list a.is-done .tr-check { visibility: visible; color: var(--gold); }
  .tr-list a.is-done { color: var(--gold-soft); }
  .tr-min { margin-left: auto; font-size: 11.5px; color: var(--text-faint); }
  .tr-mod summary { padding-left: 16px; }
  @media (max-width: 700px) { .site-frame { aspect-ratio: auto; height: 640px; } }
  .continue-title { margin: 0 0 4px; font-size: 20px; }
  .continue-sub { margin: 0 0 8px; font-size: 14px; }
  .continue-lesson { margin: 0; font-family: var(--mono); font-size: 15px; color: var(--gold-soft); }
</style>

<script>
  import { getDoneMap, getLessonIndex, onProgress } from '../lib/progress';
  import { withBase } from '../lib/urls';

  // 站内地图目录树：学过的课打金勾
  function refreshTree() {
    const done = getDoneMap();
    document.querySelectorAll<HTMLAnchorElement>('[data-tree-lesson]').forEach((a) => {
      a.classList.toggle('is-done', Boolean(done[a.dataset.treeLesson]));
    });
  }
  refreshTree();
  onProgress(refreshTree);

  function refresh() {
    const index = getLessonIndex();
    const ids = Object.keys(index);
    // 模块进度条
    const byModule = new Map<string, { done: number; total: number }>();
    for (const id of ids) {
      const m = id.split('/')[0];
      const s = byModule.get(m) ?? { done: 0, total: 0 };
      s.total += 1;
      if (getDoneMap()[id]) s.done += 1;
      byModule.set(m, s);
    }
    document.querySelectorAll<HTMLElement>('[data-module-card]').forEach((card) => {
      const m = card.getAttribute('data-module-card')!;
      const s = byModule.get(m);
      const pct = s && s.total ? Math.round((s.done / s.total) * 100) : 0;
      const bar = card.querySelector<HTMLElement>('[data-module-bar]');
      const pctEl = card.querySelector<HTMLElement>(`[data-module-pct="${m}"]`);
      if (bar) bar.style.width = `${pct}%`;
      if (pctEl) pctEl.textContent = `${pct}%`;
    });
    // 继续学习：第一个未完成的课
    const slot = document.querySelector('[data-continue-slot]');
    const btn = document.querySelector<HTMLAnchorElement>('[data-continue-btn]');
    const firstUndone = ids.find((id) => !getDoneMap()[id]);
    if (slot && btn) {
      if (firstUndone) {
        slot.textContent = `> ${index[firstUndone].t}`;
        btn.href = withBase(`/modules/${firstUndone}/`);
        btn.hidden = false;
      } else if (ids.length) {
        slot.textContent = '> 全部学完了，你就是科组的技术担当！';
        btn.hidden = false;
        btn.textContent = '再逛逛工具箱 →';
        btn.href = withBase('/toolbox/');
      }
    }
  }
  refresh();
  onProgress(refresh);
  // 新用户隐藏"继续学习"死区
  const contSec = document.querySelector('.continue-sec');
  if (contSec && !Object.keys(getDoneMap()).length) contSec.style.display = 'none';
</script>
