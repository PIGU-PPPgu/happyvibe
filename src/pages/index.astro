---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminalWindow from '../components/TerminalWindow.astro';
import TypeWriter from '../components/TypeWriter.astro';
import ModuleCarousel from '../components/ModuleCarousel.astro';
import { withBase } from '../lib/urls';

const lessons = await getCollection('lessons');
const totalLessons = lessons.length;
const moduleCount = new Set(lessons.map((l) => l.data.module)).size;

const heroLines = [
  '$ happyvibe --start',
  '> 集团教师 AI 赋能学习站',
  '> 理念：AI 不该成为负担，用好 AI = 减负增效',
  '$ load modules ... done ✓',
];
---
<BaseLayout>
  <section class="container hero">
    <TerminalWindow title="happyvibe — zsh">
      <p class="hero-typo mono">
        <TypeWriter lines={heroLines} />
      </p>
      <h1 class="hero-title">
        <span class="hero-gold">让每一位老师都可以用好 AI，减负增效。</span>
      </h1>
      <p class="hero-sub">
        这里整理了集团培训的全部内容：{totalLessons} 节课、{moduleCount} 个模块，
        从 AI 认知到 Vibe Coding，按你自己的节奏学。
      </p>
      <div class="hero-cta">
        <a class="btn btn-gold" href={withBase('/path/')}>▶ 按路线图学习</a>
        <a class="btn btn-ghost" href={withBase('/toolbox/')}>工具箱</a>
        <button class="btn btn-ghost" type="button" data-search-open>⌕ 搜索课程 <kbd class="kbd">⌘K</kbd></button>
      </div>
    </TerminalWindow>
  </section>

  <section class="container start-here">
    <h2 class="sh-title">从哪里开始？—— 三种学法，选一个</h2>
    <div class="start-grid">
      <a class="start-card card" href={withBase('/modules/software/workbuddy/')}>
        <h3 class="sc-t">我要直接上手一个工具</h3>
        <p class="sc-d">WorkBuddy 手把手六课，今天学今天用。<span class="sc-tag mono">最推荐</span></p>
      </a>
      <a class="start-card card" href={withBase('/modules/creation/task-library/')}>
        <h3 class="sc-t">我想解决一个具体问题</h3>
        <p class="sc-d">课堂不生动？重复劳动多？去任务库按目标挑任务。</p>
      </a>
      <a class="start-card card" href={withBase('/path/')}>
        <h3 class="sc-t">我想系统学一遍</h3>
        <p class="sc-d">跟学习路线图走，从认知到做出作品，一站一站来。</p>
      </a>
    </div>
  </section>

  <ModuleCarousel />

  <section class="container continue-sec">
    <div class="continue-card card">
      <div>
        <h2 class="continue-title">继续学习</h2>
        <p class="continue-sub text-muted">从上次停下的地方接着来。</p>
        <p class="continue-lesson" data-continue-slot>加载中…</p>
      </div>
      <a class="btn btn-gold" href={withBase('/path/')} data-continue-btn hidden>去上课 →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: 56px 0 24px; }
  .hero-typo { font-size: 14px; color: var(--purple-soft); min-height: 5.9em; margin: 0 0 18px; }
  .hero-title { margin: 0 0 14px; font-size: clamp(28px, 5vw, 46px); line-height: 1.3; }
  .hero-gold { color: var(--gold); }
  .hero-sub { margin: 0 0 26px; color: var(--text-muted); max-width: 560px; }
  .hero-cta { display: flex; gap: 14px; flex-wrap: wrap; }
  .start-here { margin-top: 52px; }
  .sh-title { font-size: 20px; margin: 0 0 16px; color: #ffd34d; }
  .start-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; }
  .start-card { padding: 20px 22px; color: var(--text); display: flex; flex-direction: column; gap: 6px; }
  .start-card:hover { text-decoration: none; }
  .sc-t { margin: 0; font-size: 17px; }
  .sc-d { margin: 0; font-size: 13.5px; color: var(--text-muted); line-height: 1.7; }
  .sc-tag { font-size: 11px; color: #2a1c00; background: linear-gradient(135deg, var(--gold-soft), var(--gold));
            border-radius: 4px; padding: 1px 8px; margin-left: 6px; font-weight: 700; }
  .sec-head { margin: 64px 0 24px; }
  .sec-title { margin: 0 0 6px; font-size: clamp(22px, 3vw, 30px); }
  .sec-code { font-size: 14px; color: var(--text-faint); font-weight: 400; }
  .sec-sub { margin: 0; }
  .module-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
  .module-card { padding: 22px; color: var(--text); display: flex; flex-direction: column; gap: 6px; }
  .module-card:hover { text-decoration: none; }
  .mc-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
  .mc-icon { font-size: 22px; font-family: var(--mono); }
  .mc-code { font-size: 13px; font-weight: 700; letter-spacing: 0.1em; }
  .mc-title { margin: 0; font-size: 19px; }
  .mc-sub { margin: 0 0 8px; font-size: 13.5px; color: var(--text-muted); flex: 1; }
  .mc-mode {
    align-self: flex-start; font-size: 11.5px; padding: 1px 9px; border-radius: 4px;
    border: 1px solid; opacity: .9;
  }
  .mc-foot { display: flex; align-items: center; gap: 10px; margin-top: 14px; }
  .mc-count { font-size: 12px; color: var(--text-faint); }
  .mc-bar { flex: 1; height: 6px; background: var(--bg-deep); border-radius: 3px; overflow: hidden; border: 1px solid var(--line); }
  .mc-bar-fill { height: 100%; width: 0; background: linear-gradient(90deg, var(--purple-bright), var(--gold)); transition: width 0.5s ease; }
  .mc-pct { font-size: 12px; color: var(--gold-soft); min-width: 34px; text-align: right; }
  .continue-sec { margin-block: 56px 20px; }
  .continue-card { padding: 26px 28px; display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .continue-title { margin: 0 0 4px; font-size: 20px; }
  .continue-sub { margin: 0 0 8px; font-size: 14px; }
  .continue-lesson { margin: 0; font-family: var(--mono); font-size: 15px; color: var(--gold-soft); }
</style>

<script>
  import { getDoneMap, getLessonIndex, onProgress } from '../lib/progress';
  import { withBase } from '../lib/urls';

  function refresh() {
    const index = getLessonIndex();
    const ids = Object.keys(index);
    // 模块进度条
    const byModule = new Map<string, { done: number; total: number }>();
    for (const id of ids) {
      const m = id.split('/')[0];
      const s = byModule.get(m) ?? { done: 0, total: 0 };
      s.total += 1;
      if (getDoneMap()[id]) s.done += 1;
      byModule.set(m, s);
    }
    document.querySelectorAll<HTMLElement>('[data-module-card]').forEach((card) => {
      const m = card.getAttribute('data-module-card')!;
      const s = byModule.get(m);
      const pct = s && s.total ? Math.round((s.done / s.total) * 100) : 0;
      const bar = card.querySelector<HTMLElement>('[data-module-bar]');
      const pctEl = card.querySelector<HTMLElement>(`[data-module-pct="${m}"]`);
      if (bar) bar.style.width = `${pct}%`;
      if (pctEl) pctEl.textContent = `${pct}%`;
    });
    // 继续学习：第一个未完成的课
    const slot = document.querySelector('[data-continue-slot]');
    const btn = document.querySelector<HTMLAnchorElement>('[data-continue-btn]');
    const firstUndone = ids.find((id) => !getDoneMap()[id]);
    if (slot && btn) {
      if (firstUndone) {
        slot.textContent = `> ${index[firstUndone].t}`;
        btn.href = withBase(`/modules/${firstUndone}/`);
        btn.hidden = false;
      } else if (ids.length) {
        slot.textContent = '> 全部学完了，你就是科组的技术担当！';
        btn.hidden = false;
        btn.textContent = '再逛逛工具箱 →';
        btn.href = withBase('/toolbox/');
      }
    }
  }
  refresh();
  onProgress(refresh);
</script>
