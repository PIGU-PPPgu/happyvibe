---
import { withBase } from '../lib/urls';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <p class="footer-logo mono">▚▞ HAPPYVIBE<span aria-hidden="true">_</span></p>
      <p class="footer-slogan">用好 AI = 减负增效</p>
      <p class="footer-note text-muted">内容源自集团教师培训 · 仅供内部学习交流 · 微信公众号：Pigou Workshop</p>
    </div>
    <nav class="footer-nav" aria-label="页脚导航">
      <a href={withBase('/')}>首页</a>
      <a href={withBase('/path/')}>学习路线图</a>
      <a href={withBase('/contest/')}>比赛专区</a> · <a href={withBase('/toolbox/')}>工具箱</a>
      <a href={withBase('/challenge/')}>21 天挑战</a>
      <a href={withBase('/facilitator/')}>培训者工具包</a>
      <a href={withBase('/about/')}>关于本站</a>
      <button class="footer-tour" type="button" data-tour-start>新手教程</button>
    </nav>
  </div>
  <div class="container footer-meta mono">
    <span>© {year} 吴林璋 · 公众号 Pigou Workshop</span>
    <span class="footer-cmd" aria-hidden="true">$ exit 0 # 用好 AI，减负增效</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 80px;
    border-top: 1px solid var(--line);
    background: var(--bg-deep);
    padding: 40px 0 28px;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    justify-content: space-between;
  }
  .footer-logo { color: var(--gold); font-weight: 700; letter-spacing: 0.06em; margin: 0 0 6px; }
  .footer-slogan { margin: 0 0 4px; color: var(--text); }
  .footer-note { margin: 0; font-size: 13px; }
  .footer-nav { display: flex; flex-direction: column; gap: 8px; font-size: 14px; }
  .footer-nav a { color: var(--text-muted); }
  .footer-tour {
    background: none; border: 0; padding: 0; cursor: pointer; text-align: left;
    color: var(--text-muted); font-size: 14px; font-family: var(--sans);
    border-bottom: 1px dashed var(--line);
  }
  .footer-tour:hover { color: var(--gold-soft); }
  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    justify-content: space-between;
    margin-top: 32px;
    padding-top: 18px;
    border-top: 1px dashed var(--line);
    font-size: 12px;
    color: var(--text-faint);
  }
</style>

<script>
  // 页脚「新手教程」：回首页重看引导
  document.querySelectorAll<HTMLButtonElement>('[data-tour-start]').forEach((btn) => {
    btn.addEventListener('click', () => {
      try { sessionStorage.setItem('hv-tour-run', '1'); } catch {}
      location.href = '/';
    });
  });
</script>
