---
import { withBase } from '../lib/urls';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <p class="footer-logo mono">▚▞ HAPPYVIBE<span aria-hidden="true">_</span></p>
      <p class="footer-slogan">学会「偷懒」 = 减负增效</p>
      <p class="footer-note text-muted">内容源自集团教师培训 · 仅供内部学习交流</p>
    </div>
    <nav class="footer-nav" aria-label="页脚导航">
      <a href={withBase('/')}>首页</a>
      <a href={withBase('/path/')}>学习路线图</a>
      <a href={withBase('/toolbox/')}>工具箱</a>
      <a href={withBase('/about/')}>关于本站</a>
    </nav>
  </div>
  <div class="container footer-meta mono">
    <span>© {year} 港中深附属道远学校 · 吴林璋</span>
    <span class="footer-cmd" aria-hidden="true">$ exit 0 # 今天也要愉快地偷懒</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 80px;
    border-top: 1px solid var(--line);
    background: var(--bg-deep);
    padding: 40px 0 28px;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    justify-content: space-between;
  }
  .footer-logo { color: var(--gold); font-weight: 700; letter-spacing: 0.06em; margin: 0 0 6px; }
  .footer-slogan { margin: 0 0 4px; color: var(--text); }
  .footer-note { margin: 0; font-size: 13px; }
  .footer-nav { display: flex; flex-direction: column; gap: 8px; font-size: 14px; }
  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    justify-content: space-between;
    margin-top: 32px;
    padding-top: 18px;
    border-top: 1px dashed var(--line);
    font-size: 12px;
    color: var(--text-faint);
  }
</style>
