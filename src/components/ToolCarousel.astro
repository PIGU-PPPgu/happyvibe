---
/**
 * 工具箱顶部分类轮播卡（与首页 ModuleCarousel 同款交互）
 * 拖动甩动翻页 · 弹簧回弹 · 悬停侧卡直接切换 · 圆点跳转
 * 点「进入」通过 hash 路由切到工具箱对应分类视图
 */
import type { CollectionEntry } from 'astro:content';

interface CatWithItems {
  key: string;
  code: string;
  label: string;
  icon: string;
  desc: string;
  accent: string;
  items: CollectionEntry<'tools'>[];
}

interface Props {
  cats: CatWithItems[];
}

const { cats } = Astro.props;
const cards = cats.map((c) => ({
  ...c,
  count: c.items.length,
  picks: c.items.slice(0, 3).map((t) => t.data.name),
}));
---

<section class="tool-carousel" data-toolcarousel>
  <header class="sec-head">
    <h2 class="sec-title">工具分类 <span class="mono sec-code">// 拖动翻页 · 点圆点跳转</span></h2>
    <p class="sec-sub text-muted">每张卡片列出这一类的代表工具，点「进入」跳到该分类。</p>
  </header>

  <div class="carousel">
    <div class="stage" data-tstage>
      {cards.map((c) => (
        <article class="tcard" data-tcard data-key={c.key} style={`--accent:${c.accent}`}>
          <div class="tc-top">
            <span class="tc-icon mono" aria-hidden="true">{c.icon}</span>
            <span class="tc-code mono">{c.code}</span>
          </div>
          <h3 class="tc-title">{c.label}</h3>
          <p class="tc-sub">{c.desc}</p>
          <ul class="tc-picks" aria-label="代表工具">
            {c.picks.map((p) => <li>{p}</li>)}
          </ul>
          <div class="tc-foot">
            <span class="tc-count mono">{c.count} 个工具</span>
            <span class="tc-go mono">查看 →</span>
          </div>
        </article>
      ))}
      <div class="drag-surface" data-tdrag aria-label="拖动切换分类"></div>
    </div>

    <div class="controls">
      <button class="arrow" type="button" data-tprev aria-label="上一个分类">←</button>
      <div class="dots" data-tdots>
        {cards.map((c, i) => (
          <button class="dot" type="button" data-tdot={i} aria-label={`跳到 ${c.label}`}></button>
        ))}
      </div>
      <button class="arrow" type="button" data-tnext aria-label="下一个分类">→</button>
    </div>

    <a class="cta btn btn-gold" data-tcta href={`#${cards[0].key}`}>
      进入 <span data-tcta-label>{cards[0].label}</span> →
    </a>
  </div>
</section>

<style>
  .carousel { user-select: none; }
  .stage {
    position: relative; height: 380px; display: flex; align-items: center; justify-content: center;
    overflow: hidden; touch-action: pan-y;
  }
  .tcard {
    position: absolute; width: min(400px, 82vw); height: 300px; border-radius: 18px; overflow: hidden;
    pointer-events: none;
    background: linear-gradient(160deg, var(--bg-panel-2), var(--bg-inset));
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    box-shadow: 0 18px 50px rgba(0, 0, 0, .45), 0 0 30px color-mix(in srgb, var(--accent) 22%, transparent);
    padding: 26px 28px; display: flex; flex-direction: column; will-change: transform;
  }
  .tc-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
  .tc-icon { font-size: 30px; color: var(--accent); }
  .tc-code { font-size: 14px; font-weight: 700; letter-spacing: .12em; color: var(--accent); }
  .tc-title { font-size: 27px; margin: 0 0 6px; line-height: 1.3; }
  .tc-sub { font-size: 15px; color: var(--text-muted); line-height: 1.7; }
  .tc-picks { list-style: none; margin: 14px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .tc-picks li {
    font-size: 12px; color: var(--text-muted); border: 1px dashed var(--line);
    padding: 2px 9px; border-radius: 5px;
  }
  .tc-foot { display: flex; align-items: center; justify-content: space-between; margin-top: auto; padding-top: 14px; }
  .tc-count { font-size: 12.5px; color: var(--text-faint); }
  .tc-go { font-size: 12.5px; color: var(--accent); }

  .drag-surface { position: absolute; inset: 0; z-index: 50; cursor: grab; touch-action: pan-y; }
  .drag-surface:active { cursor: grabbing; }

  .controls { display: flex; align-items: center; justify-content: center; gap: 18px; margin-top: 18px; }
  .arrow {
    width: 42px; height: 42px; border-radius: 50%; border: 1px solid var(--line-strong);
    background: var(--bg-panel); color: var(--text); font-size: 17px; cursor: pointer;
    transition: border-color .2s, color .2s;
  }
  .arrow:hover { border-color: var(--line-gold); color: var(--gold); }
  .dots { display: flex; gap: 8px; }
  .dot {
    width: 9px; height: 9px; border-radius: 2px; border: 0; padding: 0; cursor: pointer;
    background: var(--line-strong); transition: all .25s;
  }
  .dot.active { background: var(--gold); width: 22px; }

  .cta { display: flex; margin: 20px auto 0; width: fit-content; }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('[data-tstage]');
  if (stage) {
    const cards = [...stage.querySelectorAll<HTMLElement>('[data-tcard]')];
    const total = cards.length;
    const drag = stage.querySelector<HTMLElement>('[data-tdrag]')!;
    const dots = [...stage.parentElement!.querySelectorAll<HTMLButtonElement>('[data-tdot]')];
    const cta = document.querySelector<HTMLAnchorElement>('[data-tcta]')!;
    const ctaLabel = cta.querySelector<HTMLElement>('[data-tcta-label]')!;

    // 响应式参数（对照不同屏宽）
    const cfg = () => {
      const w = innerWidth;
      if (w < 640) return { dist: 120, vel: 500, sens: 180, x: 96, y: 22, rot: 8, shrink: .06 };
      if (w < 1024) return { dist: 160, vel: 650, sens: 220, x: 140, y: 30, rot: 10, shrink: .09 };
      return { dist: 210, vel: 850, sens: 250, x: 185, y: 40, rot: 12, shrink: .12 };
    };

    let progress = 0;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let raf = 0;

    function setProgress(p: number) { progress = p; render(); }
    function render() {
      const c = cfg();
      cards.forEach((card, i) => {
        let o = (i - progress) % total;
        if (o > total / 2) o -= total;
        if (o < -total / 2) o += total;
        const ao = Math.abs(o);
        card.style.transform = `translateX(${o * c.x}px) translateY(${ao * c.y}px) rotate(${ao < .05 ? 0 : o * c.rot}deg) scale(${1 - ao * c.shrink})`;
        card.style.opacity = String(Math.max(0, Math.min(1, 1.15 - ao * .45)));
        card.style.zIndex = String(100 - Math.round(ao * 10));
      });
      // 前卡信息 + CTA 指向
      const front = ((Math.round(progress) % total) + total) % total;
      dots.forEach((d, i) => d.classList.toggle('active', i === front));
      const key = cards[front].dataset.key!;
      const label = cards[front].querySelector('.tc-title')?.textContent ?? '';
      if (cta.getAttribute('href') !== '#' + key) {
        cta.href = '#' + key;
        ctaLabel.textContent = label;
      }
    }

    function springTo(target: number) {
      if (reduced) { setProgress(target); return; }
      cancelAnimationFrame(raf);
      let pos = progress, v = 0, last = performance.now();
      const k = 210, damp = 30, m = 1;
      const step = (now: number) => {
        const dt = Math.min(.032, (now - last) / 1000); last = now;
        v += (-k * (pos - target) - damp * v) / m * dt;
        pos += v * dt;
        setProgress(pos);
        if (Math.abs(pos - target) > .001 || Math.abs(v) > .001) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    }

    // 拖拽（move/up 挂 window，避免指针捕获丢失）
    let startX = 0, startP = 0, lastX = 0, lastT = 0, vel = 0, down = false;
    const onMove = (e: PointerEvent) => {
      if (!down) return;
      const c = cfg();
      const now = performance.now();
      vel = (e.clientX - lastX) / Math.max(1, now - lastT) * 1000;
      lastX = e.clientX; lastT = now;
      setProgress(startP + (startX - e.clientX) / c.sens);
    };
    const onUp = (e: PointerEvent) => {
      if (!down) return;
      down = false;
      window.removeEventListener('pointermove', onMove);
      window.removeEventListener('pointerup', onUp);
      const c = cfg();
      let shift = Math.round(-(e.clientX - startX) / c.dist - vel / c.vel);
      shift = Math.max(-3, Math.min(3, shift));
      springTo(Math.round(startP) + shift);
    };
    drag.addEventListener('pointerdown', (e) => {
      down = true; startX = lastX = e.clientX; startP = progress; lastT = performance.now(); vel = 0;
      cancelAnimationFrame(raf);
      clearTimeout(hoverTimer);
      window.addEventListener('pointermove', onMove);
      window.addEventListener('pointerup', onUp);
    });

    // 悬停侧卡：停留片刻直接划到该卡
    let hoverTimer = 0, hoverTarget = -1;
    const frontIndex = () => ((Math.round(progress) % total) + total) % total;
    drag.addEventListener('pointermove', (e) => {
      if (down) { clearTimeout(hoverTimer); return; }
      const rect = stage.getBoundingClientRect();
      const px = e.clientX - rect.left - rect.width / 2;
      const c = cfg();
      let best = -1, bestDist = 1e9;
      cards.forEach((_, i) => {
        let o = (i - progress) % total;
        if (o > total / 2) o -= total;
        if (o < -total / 2) o += total;
        const dist = Math.abs(px - o * c.x);
        if (dist < 180 && dist < bestDist) { bestDist = dist; best = i; }
      });
      if (best === -1 || best === frontIndex()) { clearTimeout(hoverTimer); hoverTarget = -1; return; }
      if (hoverTarget !== best) {
        clearTimeout(hoverTimer);
        hoverTarget = best;
        hoverTimer = window.setTimeout(() => {
          const k = Math.round((progress - best) / total);
          springTo(best + k * total);
        }, 320);
      }
    });
    drag.addEventListener('pointerleave', () => clearTimeout(hoverTimer));

    // 按钮 & 圆点
    document.querySelector('[data-tprev]')?.addEventListener('click', () => springTo(Math.round(progress) - 1));
    document.querySelector('[data-tnext]')?.addEventListener('click', () => springTo(Math.round(progress) + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => springTo(i)));
    // 键盘左右（焦点在轮播区时）
    stage.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') springTo(Math.round(progress) - 1);
      if (e.key === 'ArrowRight') springTo(Math.round(progress) + 1);
    });

    render();
  }
</script>
