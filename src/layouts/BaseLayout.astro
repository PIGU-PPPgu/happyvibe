---
import '../styles/tokens.css';
import { getCollection } from 'astro:content';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SearchModal from '../components/SearchModal.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = '集团教师 AI 赋能学习站 · 学会「偷懒」= 减负增效' } = Astro.props;
const pageTitle = title ? `${title} · HappyVibe 数智学园` : 'HappyVibe 数智学园 · 集团教师 AI 赋能学习站';

const lessons = (await getCollection('lessons')).sort(
  (a, b) => a.data.module.localeCompare(b.data.module) || a.data.order - b.data.order
);
const lessonIndex = Object.fromEntries(
  lessons.map((l) => [`${l.data.module}/${l.slug}`, { t: l.data.title, m: l.data.module, d: l.data.description }])
);

const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' fill='%23150e22'/%3E%3Crect x='2' y='2' width='2' height='12' fill='%23feb300'/%3E%3Crect x='6' y='2' width='2' height='12' fill='%23feb300'/%3E%3Crect x='4' y='7' width='2' height='2' fill='%23feb300'/%3E%3Crect x='10' y='2' width='2' height='12' fill='%23a63d97'/%3E%3Crect x='14' y='2' width='2' height='12' fill='%23a63d97'/%3E%3C/svg%3E";
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={favicon} />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <SearchModal />
    <script type="application/json" id="hv-lesson-index" set:html={JSON.stringify(lessonIndex)} />
  </body>
</html>

<style>
  main {
    min-height: calc(100vh - var(--header-h));
  }
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 8px;
    z-index: 200;
    padding: 8px 16px;
    background: var(--gold);
    color: #2a1c00;
    border-radius: var(--radius-sm);
    font-weight: 600;
  }
  .skip-link:focus {
    left: 8px;
  }
</style>
